    barCols.forEach((c, i) => drawBar(`bar_${which}_${i}`, c, d.fields[c].counts));
    drawHeat(`heat_${which}`, cols, d.fields, d.summary.total);
    if (d.years.length) drawTimeline(`time_${which}`, d.years, d.date_col);
  } catch (e) {
    box.innerHTML = `<p class="hint">✘ ${esc(e.message)}</p>`;
  }
}

function drawBar(divId, col, counts) {
  const top = counts.slice(0, 20).reverse();
  const el = $(divId);
  if (!el || !top.length) { if (el) el.innerHTML = `<p class="hint">${t('c.noData', '暂无数据')}</p>`; return; }
  Plotly.react(el, [{
    type: 'bar', orientation: 'h',
    x: top.map(x => x[1]), y: top.map(x => x[0]),
    marker: {color: '#4C72B0'}, text: top.map(x => x[1]), textposition: 'auto',
  }], {
    margin: {l: 190, r: 20, t: 14, b: 36}, height: Math.max(220, top.length * 24 + 60),
    xaxis: {title: {text: 'Count', font: {size: 11}}},
    font: {size: 10},
  }, {displayModeBar: false, responsive: true});
}

function drawHeat(divId, cols, fields, total) {
  const el = $(divId);
  if (!el) return;
  const pct = c => {
    const f = fields[c] || {missing: 0};
    return Math.round(f.missing / Math.max(1, total) * 1000) / 10;
  };
  Plotly.react(el, [{
    type: 'heatmap',
    z: [cols.map(pct)],
    x: cols, y: [t('mt.missPct', '缺失 %')],
    colorscale: 'RdYlGn', reversescale: true, zmin: 0, zmax: 100,
    hovertemplate: '%{x}: %{z}%<extra></extra>',
  }], {
    margin: {l: 60, r: 10, t: 10, b: 130}, height: 280, font: {size: 10},
  }, {displayModeBar: false, responsive: true});
}

function drawTimeline(divId, years, dateCol) {
  const el = $(divId);
  if (!el) return;
  Plotly.react(el, [{
    type: 'bar', x: years.map(y => y[0]), y: years.map(y => y[1]),
    marker: {color: '#55A868'}, text: years.map(y => y[1]), textposition: 'auto',
  }], {
    margin: {l: 50, r: 20, t: 10, b: 40}, height: 280,
    xaxis: {title: {text: 'Year', font: {size: 11}}},
    yaxis: {title: {text: 'Records', font: {size: 11}}},
    font: {size: 10},
  }, {displayModeBar: false, responsive: true});
}

function saveChart(divId, name) {
  const el = $(divId);
  if (!el) return;
  const safe = String(name).replace(/[^\w.-]+/g, '_');
  Plotly.downloadImage(el, {format: 'png', scale: 2, filename: safe,
    width: Math.max(800, el.clientWidth), height: el.clientHeight || 300});
}

/* ── SCI 全景图（引擎出图 + 画廊） ── */
let _plotWatch = null;
async function metaPlot(btn) {
  if (!MT.project) return;
  try {
    const r = await fetch('/api/meta/plot', {method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({name: MT.project})});
    if (!r.ok) { alert((await r.json()).error || '启动失败'); return; }
    const d = await r.json();
    toast(t('mt.plotStarted', '绘图任务已启动'), d.task, {ttl: 3000});
    refreshTasks();
    _plotWatch = {task: d.task};
    pollLog(d.task, whichSciLog(), null);
    watchTaskBtn(d.task, btn, '⏳ 绘图中…', t2 => {
      _plotWatch = null;
      if (t2.status === 'done') { loadSciGallery(); loadColls(); }
    }, {cancelable: true});
  } catch (e) { alert('无法连接平台服务: ' + e); }
}
function whichSciLog() {
  // 日志盒子放在对应图表面板下（不存在则临时挂到当前可见面板）
  const active = document.querySelector('.mt-sec:not([style*="none"])');
  if (!active) return 'svCharts';
  let el = active.querySelector('.sci-log');
  if (!el) {
    el = document.createElement('div');
    el.className = 'search-log sci-log';
    active.querySelector('.card').appendChild(el);
  }
  el.id = el.id || ('sciLog_' + Math.random().toString(36).slice(2, 7));
  return el.id;
}

async function loadSciGallery() {
  for (const [which, boxId] of [['search', 'svSci'], ['core14', 'ivSci']]) {
    const panel = $(boxId);
    if (!panel || !MT.project) continue;
    try {
      const d = await jfetch(`/api/meta/plot/files?name=${encodeURIComponent(MT.project)}`);
      if (!d.files.length) { panel.innerHTML = ''; continue; }
      const pngs = d.files.filter(f => f.name.endsWith('.png'));
      const pdfs = d.files.filter(f => f.name.endsWith('.pdf'));
      const figTitle = f => PLOT_TITLES[f.name.replace(/\.(png|pdf)$/, '')] || f.name;
      panel.innerHTML = `<div class="chart-box" style="margin-bottom:10px">
        <div class="chart-head"><b>📊 ${t('mt.plotPanel', '数据全景图')}</b>
        <span style="flex:1"></span>
        <span class="hint" style="margin:0">${t('mt.plotSub', '已生成的 SCI 成图')}</span></div>
        <div class="fig-grid">` +
        pngs.map(f => `<div class="fig-item">
          <a href="${f.url}" target="_blank" title="点击查看原图"><img src="${f.url}" loading="lazy" alt="${esc(f.name)}"></a>
          <p class="hint">${esc(figTitle(f))} · ${esc(f.size)} · <a href="${f.url}" download>下载原图</a></p>
        </div>`).join('') + `</div>` +
        (pdfs.length ? `<p class="hint" style="margin:8px 0 0">PDF：` +
          pdfs.map(f => `<a class="btn small" style="margin:2px" href="${f.url}" download>📄 ${esc(figTitle(f))}</a>`).join('') + `</p>` : '') +
        `</div>`;
    } catch (e) { panel.innerHTML = ''; }
  }
}

/* ── 初始化 ── */
(function init() {
  const params = new URLSearchParams(location.search);
  const wantP = params.get('p') || '';
  const hash = (location.hash || '').replace('#', '');
  (async () => {
    await loadColls();
    const pick = MT.colls.find(c => c.name === wantP) || MT.colls[0];
    if (pick) await setProject(pick.name);
    loadSciGallery();
    mtShow(MT_SECS.includes(hash) ? hash : 'search');
  })();
})();
</script>
