<script src="/static/i18n.js?v={{ asset_v }}"></script>
<script src="/static/app.js?v={{ asset_v }}"></script>
<script src="/static/plotly.min.js?v={{ asset_v }}"></script>
<script>
/* ═════════ 公共数据检索工作台（复刻 MMPV-RNA metadata_gui 双存储 8 标签） ═════════ */
'use strict';

async function jfetch(url, opts) {
  const r = await fetch(url, opts);
  const d = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(d.error || ('HTTP ' + r.status));
  return d;
}

const MT = {
  project: '', colls: [],
  page: {local: 1, sb: 1, ib: 1},
  perPage: {local: 20, sb: 20, ib: 20},
  sort: {},                       // view -> {col, dir}
  filter: {local: {q: '', fields: {}}, sb: {q: '', qcol: '', fields: {}},
           ib: {q: '', qcol: '', fields: {}}},
  cols: {},                       // which -> [columns]
  sel: {search: new Set(), core14: new Set()},
  aiMarks: new Set(),             // `${which}:${row}:${col}` 本会话 AI 修改标记（绿色）
  editRow: {search: -1, core14: -1},
  recData: {search: null, core14: null},
  vizField: {search: 'Tissue', core14: 'Tissue'},
  importWhich: 'search',
  aiWhich: 'search',
  lastData: {},                   // view -> 最近一次表响应（统计行轻量更新用）
};

const VIEW = {
  local: {which: 'search', box: 'mtLocalTbl', pager: 'mtLocalPager',
          stats: 'mtLocalCount', editable: false, checks: false},
  sb:    {which: 'search', box: 'sbTbl', pager: 'sbPager', stats: 'sbStats',
          editable: true, checks: true},
  ib:    {which: 'core14', box: 'ibTbl', pager: 'ibPager', stats: 'ibStats',
          editable: true, checks: true},
};

const LINK_COLS = new Set(['Run', 'BioProject', 'PMID', 'BioSample', 'TaxID']);
const NA_SET = new Set(['na', 'n/a', 'not_provided', 'not_provided.', 'not collected',
                        'missing', 'none', 'unknown', 'nan', '-', '', ' ']);
const FILTER_FIELDS = ['ScientificName', 'Tissue', 'Source', 'Location',
                       'BioProject', 'LibrarySource', 'CenterName'];
const PLOT_TITLES = {
  'Combined_Landscape_Full': '🗺 总览合并图（3×2）',
  'Panel_A_temporal': 'A · 发布时间分布',
  'Panel_B_database': 'B · 数据来源比例（SRA/GSA）',
  'Panel_C_organizations': 'C · 贡献机构 Top10',
  'Panel_D_tissues': 'D · 组织偏好 Top10',
  'Panel_E_regions': 'E · 采样地理分布 Top10',
  'Panel_F_stages': 'F · 发育时期偏好 Top10',
};
const isNa = v => NA_SET.has(String(v ?? '').trim().toLowerCase());

function buildUrl(col, v) {
  v = String(v ?? '').trim();
  if (!v) return '';
  const c = col.toLowerCase();
  if (c === 'run') {
    if (/^(SRR|ERR|DRR|SRX|ERX|DRX)/.test(v))
      return 'https://www.ncbi.nlm.nih.gov/sra/' + v;
    if (v.startsWith('CRR'))
      return 'https://ngdc.cncb.ac.cn/gsa/search?searchTerm=' + v;
    return 'https://www.ncbi.nlm.nih.gov/sra/?term=' + v;
  }
  if (c === 'bioproject') {
    if (v.startsWith('PRJNA')) return 'https://www.ncbi.nlm.nih.gov/bioproject/' + v;
    if (v.startsWith('PRJCA') || v.startsWith('PRJEB'))
      return 'https://ngdc.cncb.ac.cn/bioproject/browse/' + v;
    return 'https://www.ncbi.nlm.nih.gov/bioproject/?term=' + v;
  }
  if (c === 'pmid')
    return /^\d+$/.test(v) ? 'https://pubmed.ncbi.nlm.nih.gov/' + v + '/'
      : 'https://pubmed.ncbi.nlm.nih.gov/?term=' + v;
  if (c === 'biosample')
    return /^(SAMN|SAME)/.test(v) ? 'https://www.ncbi.nlm.nih.gov/biosample/' + v
      : 'https://ngdc.cncb.ac.cn/biosample/' + v;
  if (c === 'taxid')
    return /^\d+$/.test(v) ? 'https://www.ncbi.nlm.nih.gov/taxonomy/' + v : '';
  return '';
}

/* ── 标签切换（懒加载） ── */
const MT_SECS = ['search', 'sb', 'se', 'sv', 'info', 'ib', 'ie', 'iv'];
function mtShow(id) {
  if (!MT_SECS.includes(id)) id = 'search';
  document.querySelectorAll('.mt-sec').forEach(el => {
    el.style.display = el.id === 'sec-' + id ? '' : 'none';
  });
  document.querySelectorAll('#mtPills .gt-item').forEach(a => {
    a.classList.toggle('on', a.dataset.sec === id);
  });
  history.replaceState(null, '', '/meta?p=' + encodeURIComponent(MT.project || '') + '#' + id);
  if (id === 'sb') loadView('sb');
  else if (id === 'ib') loadView('ib');
  else if (id === 'se') loadRecord('search');
  else if (id === 'ie') loadRecord('core14');
  else if (id === 'sv') loadViz('search');
  else if (id === 'iv') loadViz('core14');
  else if (id === 'search') { loadView('local'); refreshTasks(); }
}
(function mtPillInit() {
  document.querySelectorAll('#mtPills .gt-item').forEach(a => {
    a.addEventListener('click', ev => {
      ev.preventDefault(); mtShow(a.dataset.sec);
    });
  });
})();

/* ── 项目管理 ── */
async function loadColls() {
  try {
    MT.colls = await jfetch('/api/meta/collections');
  } catch (e) { setConnBanner(true); return; }
  const sel = $('mtProjectSel');
  sel.innerHTML = MT.colls.length
    ? MT.colls.map(c => `<option value="${esc(c.name)}">${esc(c.name)}</option>`).join('')
    : `<option value="">（暂无项目）</option>`;
  sel.value = MT.project;
  renderProjBadges();
  updateStatus();
}

function renderProjBadges() {
  const c = MT.colls.find(x => x.name === MT.project);
  const box = $('mtProjBadges');
  if (!c) { box.innerHTML = ''; return; }
  const n = v => (v == null ? '—' : Number(v).toLocaleString());
  const b = [];
  if (c.search) b.push(`<span class="badge2 ok">检索 ${n(c.n_runs)}</span>`);
  if (c.core14) b.push(`<span class="badge2 ${c.stale ? 'warn' : ''}">Core14 ${n(c.n_core14)}</span>`);
  if (c.full) b.push(`<span class="badge2 ${c.stale ? 'warn' : ''}">Full ${n(c.n_full)}</span>`);
  if (c.n_plots) b.push(`<span class="badge2">图表 ${n(c.n_plots)}</span>`);
  if (c.stale) b.push(`<span class="badge2 warn" title="元数据条数与最新检索不一致——重新提取元数据">⚠ 过期</span>`);
  box.innerHTML = b.join(' ');
}

function updateStatus() {
  const c = MT.colls.find(x => x.name === MT.project) || {};
  $('mtStatus').textContent =
    `Search: ${c.n_runs ?? 0} rows | Info: ${c.n_core14 ?? 0} rows | 当前项目: ${MT.project || '—'}`;
}

async function switchProject(name) {
  if (!name) return;
  await setProject(name);
  mtShow((location.hash || '').replace('#', '') || 'search');
}

async function setProject(name) {
  MT.project = name;
  MT.page = {local: 1, sb: 1, ib: 1};
  MT.sort = {};
  MT.filter = {local: {q: '', fields: {}}, sb: {q: '', qcol: '', fields: {}},
               ib: {q: '', qcol: '', fields: {}}};
  MT.sel = {search: new Set(), core14: new Set()};
  MT.editRow = {search: -1, core14: -1};
  MT.recData = {search: null, core14: null};
  MT.aiMarks.clear();
  MT.cols = {};
  MT.lastData = {};
  $('mtProjectSel').value = name;
  history.replaceState(null, '', '/meta?p=' + encodeURIComponent(name));
  renderProjBadges();
  updateStatus();
  await Promise.all([loadView('local'), loadView('sb'), loadView('ib')]);
  await Promise.all([buildLocalFilters(), buildQColSelects()]);
  const full = $('ibFullDl');
  full.href = `/meta_files/${encodeURIComponent(name)}/info/Global_Unified_Metadata_Full.csv`;
}

/* ── 通用表格视图（local 只读 / sb·ib 可编辑+勾选） ── */
function viewQuery(vkey) {
  const v = VIEW[vkey];
  const so = MT.sort[vkey] || {};
  const f = MT.filter[vkey];
  const qs = new URLSearchParams({
    which: v.which, page: MT.page[vkey], per_page: MT.perPage[vkey]});
  if (so.col) { qs.set('sort', so.col); qs.set('dir', so.dir); }
  if (f.q) { qs.set('q', f.q); if (f.qcol) qs.set('qcol', f.qcol); }
  for (const [k, val] of Object.entries(f.fields || {}))
    if (val && val !== '(any)') qs.set('f.' + k, val);
  return qs;
}

async function loadView(vkey, page) {
  const v = VIEW[vkey];
  if (!MT.project) return;
  if (page) MT.page[vkey] = page;
  const box = $(v.box);
  try {
    const d = await jfetch(`/api/meta/table/${encodeURIComponent(MT.project)}?${viewQuery(vkey)}`);
    MT.cols[v.which] = d.columns;
    renderView(vkey, d);
  } catch (e) {
    box.innerHTML = `<p class="hint">ⓘ ${esc(e.message)}</p>`;
    $(v.pager).innerHTML = '';
    $(v.stats).textContent = '';
  }
  updateSelBar(vkey);
}

function renderView(vkey, d) {
  MT.lastData[vkey] = d;
  const v = VIEW[vkey];
  const so = MT.sort[vkey] || {};
  const head = (v.checks ? '<th style="width:26px">✓</th>' : '') +
    d.columns.map((c, i) => {
      const arrow = so.col === c ? (so.dir === 'asc' ? ' ▲' : ' ▼') : '';
      return `<th class="sortable" data-sortcol="${esc(c)}" title="点击排序">${esc(c)}${arrow}</th>`;
    }).join('');
  const body = d.rows.map((row, i) => {
    const rid = d.row_ids[i];
    const run = d.run_col != null ? row[d.run_col] : '';    const tds = row.map((val, ci) => {
      const col = d.columns[ci];
      const miss = isNa(val);
      const url = (!miss && LINK_COLS.has(col)) ? buildUrl(col, val) : null;
      const cls = [];
      if (miss) cls.push('miss');
      if (MT.aiMarks.has(`${v.which}:${rid}:${col}`)) cls.push('aimark');
      if (val && /XXXX|YYYY|Country:Region|SAMNXX|PRJNAXX/.test(String(val))) cls.push('sus');
      if (url) cls.push('link');
      const editable = v.editable && !url;
      if (editable) cls.push('editable');
      let inner;
      if (url) inner = `<a href="${esc(url)}" target="_blank" rel="noopener" title="点击在浏览器打开（行级编辑页可修改）">${esc(val)}</a>`;
      if (col === 'Run' && !miss && /^[A-Z]{2,4}\d+\.?\d*$/.test(String(val).trim()))
        inner += ` <a href="javascript:void(0)" onclick="dlOneRun('${esc(String(val).trim())}')" title="该 Run 转入数据下载" style="text-decoration:none">⬇</a>`;
      else if (miss) inner = esc(val) || '&nbsp;';
      else inner = esc(val);
      return `<td class="${cls.join(' ')}" data-col="${esc(col)}"${editable ? ' title="双击编辑"' : ''}>${inner}</td>`;
    }).join('');
    const chk = v.checks
      ? `<td><input type="checkbox" data-run="${esc(run)}" data-rid="${rid}" ${MT.sel[v.which].has(String(rid)) ? 'checked' : ''}></td>` : '';
    return `<tr>${chk}${tds}</tr>`;
  }).join('');
  $(v.box).innerHTML =
    `<table class="meta-tbl"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table>`;
  const pct = d.total ? (d.n_missing / (d.total * d.columns.length) * 100) : 0;
  $(v.stats).innerHTML =
    t('mt.stats', '共 {total} 行 · 筛选后 {filtered} 行 · 缺失单元格 {miss}（{pct}%）')
      .replace('{total}', d.total.toLocaleString()).replace('{filtered}', d.filtered.toLocaleString())
      .replace('{miss}', d.n_missing.toLocaleString()).replace('{pct}', pct.toFixed(1)) +
    (v.editable ? ` · <b>${t('mt.dblEdit', '双击单元格可直接编辑')}</b>` : '') +
    ` · <a href="${d.download}" download>⬇ ${t('mt.rawDl', '下载原始表')}</a>`;
  $(v.pager).innerHTML = pagerHtml(d.page, d.pages, `pageView('${vkey}','{p}')`);
}

function pageView(vkey, p) { loadView(vkey, p); }

function sortByView(vkey, col) {
  const so = MT.sort[vkey] || (MT.sort[vkey] = {});
  if (so.col === col) so.dir = so.dir === 'asc' ? 'desc' : 'asc';
  else { so.col = col; so.dir = 'asc'; }
  loadView(vkey, 1);
}

/* 表格事件委托：排序 / 双击编辑 / 勾选 */
for (const [vkey, v] of Object.entries(VIEW)) {
  $(v.box).addEventListener('click', ev => {
    const th = ev.target.closest('th[data-sortcol]');
    if (th) sortByView(vkey, th.dataset.sortcol);
  });
  if (v.checks) {
    $(v.box).addEventListener('change', ev => {
      const cb = ev.target.closest('input[type="checkbox"][data-rid]');
      if (!cb) return;
      if (cb.checked) MT.sel[v.which].add(cb.dataset.rid);
      else MT.sel[v.which].delete(cb.dataset.rid);
      updateSelBar(vkey);
    });
  }
  if (v.editable) {
    $(v.box).addEventListener('dblclick', ev => {
      const td = ev.target.closest('td.editable');
      if (!td) return;
      const tr = td.closest('tr');
      cellEdit(td, v.which, tr, td.dataset.col);
    });
  }
}

function updateSelBar(vkey) {
  const v = VIEW[vkey];
  if (!v.checks) return;
  const bar = $(vkey === 'sb' ? 'sbSelBar' : 'ibSelBar');
  const cnt = $(vkey === 'sb' ? 'sbSelCount' : 'ibSelCount');
  const n = MT.sel[v.which].size;
  bar.style.display = n ? '' : 'none';
  cnt.textContent = t('mt.selN', '已勾选 {n} 行').replace('{n}', n);
}

/* ── 双击单元格行内编辑 ── */
function cellEdit(td, which, tr, col) {
  if (td.querySelector('input')) return;
  // 可编辑视图（sb/ib）均带勾选框，data-rid 即该行绝对行号
  const cb = tr.querySelector('input[type="checkbox"][data-rid]');
  if (!cb) return;
  const rid = Number(cb.dataset.rid);
  const old = td.textContent.replace(/\u00A0/g, ' ').trim();
  td.dataset.editing = '1';
  const w = td.clientWidth;
  td.innerHTML = `<input class="cell-input" style="width:${Math.max(w, 90)}px">`;
  const inp = td.firstChild;
  inp.value = old;
  inp.focus(); inp.select();
  let closed = false;
  const finish = async commit => {
    if (closed) return; closed = true;
    const nv = inp.value;
    td.innerHTML = esc(old) || '&nbsp;';
    delete td.dataset.editing;
    if (!commit || nv === old) return;
    try {
      const r = await jfetch('/api/meta/cell', {method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({name: MT.project, which, row: rid, col, value: nv})});
      td.textContent = r.value;
      td.classList.remove('miss', 'sus');
      if (isNa(r.value)) td.classList.add('miss');
      MT.aiMarks.delete(`${which}:${rid}:${col}`);
      updateStats(vkeyOf(which), r.n_missing);
    } catch (e) { toast(t('mt.editFail', '编辑失败'), e.message, {ttl: 5000}); }
  };
  inp.onblur = () => finish(true);
  inp.onkeydown = ev => {
    if (ev.key === 'Enter') { ev.preventDefault(); inp.onblur = null; finish(true); }
    else if (ev.key === 'Escape') { inp.onblur = null; finish(false); }
  };
}
function vkeyOf(which) { return which === 'search' ? 'sb' : 'ib'; }

/* 编辑后轻量刷新统计行（不整表重载） */
function updateStats(vkey, nMissing) {
  const d = MT.lastData[vkey];
  const v = VIEW[vkey];
  if (!d || !v) return;
  d.n_missing = nMissing;
  const pct = d.total ? (d.n_missing / (d.total * d.columns.length) * 100) : 0;
  $(v.stats).innerHTML =
    t('mt.stats', '共 {total} 行 · 筛选后 {filtered} 行 · 缺失单元格 {miss}（{pct}%）')
      .replace('{total}', d.total.toLocaleString()).replace('{filtered}', d.filtered.toLocaleString())
      .replace('{miss}', d.n_missing.toLocaleString()).replace('{pct}', pct.toFixed(1)) +
    (v.editable ? ` · <b>${t('mt.dblEdit', '双击单元格可直接编辑')}</b>` : '') +
    ` · <a href="${d.download}" download>⬇ ${t('mt.rawDl', '下载原始表')}</a>`;
}

/* ── 浏览视图筛选 ── */
function browseFilter(vkey) {
  const f = MT.filter[vkey];
  f.q = val(vkey === 'sb' ? 'sbQ' : 'ibQ');
  f.qcol = val(vkey === 'sb' ? 'sbQCol' : 'ibQCol');
  loadView(vkey, 1);
}
function browseClear(vkey) {
  $(vkey === 'sb' ? 'sbQ' : 'ibQ').value = '';
  $(vkey === 'sb' ? 'sbQCol' : 'ibQCol').value = '';
  MT.filter[vkey] = {q: '', qcol: '', fields: {}};
  loadView(vkey, 1);
}
async function buildQColSelects() {
  for (const which of ['search', 'core14']) {
    const selId = which === 'search' ? 'sbQCol' : 'ibQCol';
    const sel = $(selId);
    const cur = sel.value;
    sel.innerHTML = `<option value="">${t('mt.allCols', '全部列')}</option>` +
      (MT.cols[which] || []).map(c => `<option value="${esc(c)}">${esc(c)}</option>`).join('');
    sel.value = cur;
  }
}

/* ── 检索页本地筛选（7 字段组合，对应 GUI Local Metadata Filter） ── */
async function buildLocalFilters() {
  const grid = $('mtLocalFilters');
  const cols = MT.cols.search || [];
  const fields = FILTER_FIELDS.filter(f => cols.includes(f));
  if (!fields.length) { grid.innerHTML = ''; return; }
  let vals = {};
  try {
    const d = await jfetch(`/api/meta/unique/${encodeURIComponent(MT.project)}?which=search&cols=${fields.join(',')}`);
    vals = d.values || {};
  } catch (e) { /* 忽略 */ }
  const cur = MT.filter.local.fields;
  grid.innerHTML = fields.map(f => `
    <label><span>${esc(f)}:</span>
      <select data-ff="${esc(f)}" style="flex:1;min-width:110px">
        <option value="(any)">(any)</option>
        ${(vals[f] || []).map(v => `<option value="${esc(v)}" ${cur[f] === v ? 'selected' : ''}>${esc(v)}</option>`).join('')}
      </select></label>`).join('');
  grid.querySelectorAll('select[data-ff]').forEach(sel => {
    sel.onchange = () => {
      MT.filter.local.fields[sel.dataset.ff] = sel.value;
      loadView('local', 1);
    };
  });
}
function localFilter() {
  MT.filter.local.q = val('mtQuick');
  loadView('local', 1);
}
function localClear() {
  $('mtQuick').value = '';
  MT.filter.local = {q: '', fields: {}};
  buildLocalFilters();
  loadView('local', 1);
}

/* ── 在线检索 ── */
async function doSearch(btn) {
  const species = val('mtSpecies');
  if (!species) { alert(t('mt.needSpecies', '请填写物种拉丁名')); return; }
  $('searchActions').style.display = 'none';
  $('searchLog').textContent = `> ${t('mt.searching', '正在检索')}: ${species}\n`;
  try {
    const d = await jfetch('/api/meta/search', {method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({species, source: val('mtSource'), db: val('mtDb'),
                            detailed: $('mtDetailed').checked,
                            workers: Number(val('mtWorkers')) || 5})});
    await setProject(d.name);
    mtShow('search');
    pollLog(d.task, 'searchLog');
    toast(t('mt.started', '检索任务已启动'), d.name, {ttl: 4000});
    watchTaskBtn(d.task, btn, '⏳ 检索中…', async t2 => {
      await loadColls();
      $('searchActions').style.display = '';
      $('searchCount').textContent = t2.status === 'done'
        ? t('mt.done', '✓ 检索完成')
        : `✘ ${t2.error || t2.status}`;
      if (t2.status === 'done') { loadView('local'); loadView('sb'); }
      refreshTasks();
    }, {cancelable: true});
  } catch (e) { alert(e.message); }
}

function searchToInfo() {
  $('infoRuns').value = '';
  mtShow('info');
  toast(t('mt.sendInfo', '📤 发送到 Info 提取'),
        t('mt.sendInfoHint', '输入框留空 = 提取当前项目全部检索 Run'), {ttl: 6000});
}

/* ── 任务日志流式跟随 ── */
function pollLog(tid, boxId, onEnd) {
  const box = $(boxId);
  box.style.display = '';
  let seen = 0, fails = 0;
  const timer = setInterval(async () => {
    let t2 = null;
    try {
      const r = await fetch('/api/task/' + tid);
      if (!r.ok) throw new Error('HTTP ' + r.status);
      t2 = await r.json();
      fails = 0;
    } catch (e) {
      if (++fails >= 15) {
        clearInterval(timer);
        box.textContent += '\n[任务快照连续 30s 不可达，停止跟随]\n';
        if (onEnd) onEnd({status: 'failed', error: '任务快照丢失（服务可能已重启）'});
      }
      return;
    }
    if (t2.log && t2.log.length) {
      const fresh = t2.log.slice(Math.min(seen, t2.log.length));
      if (fresh.length) {
        box.textContent += fresh.join('\n') + '\n';
        seen = t2.log.length;
        box.scrollTop = box.scrollHeight;
      }
    }
    if (t2.status && t2.status !== 'running') {
      clearInterval(timer);
      if (t2.status !== 'done' && t2.error)
        box.textContent += `[ERROR] ${t2.error}\n`;
      if (onEnd) onEnd(t2);
    }
  }, 2000);
  return timer;
}

/* ── 页面任务列表（可停止；单轮询循环防叠加） ── */
let _taskTimer = null;
async function refreshTasks() {
  if (_taskTimer) { clearTimeout(_taskTimer); _taskTimer = null; }
  try {
    const list = await jfetch('/api/tasks');
    const mine = list.filter(t2 => /^(元数据|公共检索|AI 元数据补全|检索绘图)/.test(t2.name || ''));
    const box = $('taskBox');
    if (!mine.length) { box.innerHTML = `<p class="hint">${t('c.noTasks', '暂无任务')}</p>`; return; }
    box.innerHTML = mine.map(task => {
      const st = task.status === 'running' ? 'running' : task.status === 'done' ? 'done' : 'failed';
      const stText = task.status === 'running' ? t('c.st.running', '运行中')
        : task.status === 'done' ? t('c.st.done', '已完成')
        : task.status === 'cancelled' ? '已停止' : t('c.st.failed', '失败');
      return `<div class="card">
        <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap">
          <b>${esc(task.name)}</b>
          <span style="display:flex;gap:8px;align-items:center">
            ${task.status === 'running' ? `<button class="btn small danger" onclick="cancelTask('${task.id}')">⏹ 停止</button>` : ''}
            <span class="tstat ${st}">${stText}</span>
          </span>
        </div>
        ${task.msg ? `<p class="hint" style="margin:4px 0 0">${esc(task.msg)}${task.pct != null ? ' · ' + Math.round(task.pct) + '%' : ''}</p>` : ''}
        ${task.error ? `<div class="err">${esc(task.error)}</div>` : ''}
      </div>`;
    }).join('');
    const running = mine.some(t2 => t2.status === 'running');
    _taskTimer = setTimeout(refreshTasks, running ? 2500 : 10000);
  } catch (e) { /* ignore */ }
}
