async function runsOfRows(which, rids) {
  // 用 qcol 不行——直接拉大页（每页 500），按 row_ids 映射出 Run
  const qs = new URLSearchParams({which, per_page: 500});
  const runs = [];
  let page = 1, pages = 1;
  const want = new Set(rids.map(Number));
  do {
    qs.set('page', page);
    const d = await jfetch(`/api/meta/table/${encodeURIComponent(MT.project)}?${qs}`);
    pages = d.pages;
    d.rows.forEach((row, i) => {
      if (want.has(d.row_ids[i]) && d.run_col != null) runs.push(String(row[d.run_col]).trim());
    });
    page++;
  } while (page <= pages);
  return runs.filter(Boolean);
}

