  embedContigReport(run);   // 选中/切换运行时同步内嵌分类报告
  try {
    const r = await fetch('/api/tool/viral_contigs?run=' + encodeURIComponent(run));
    if (!r.ok) {
      box.innerHTML = '<p class="hint" style="color:#b91c1c">加载失败: '
        + esc((await r.json()).error || r.status) + '</p>';
      return;
    }
    vcRows = await r.json();
    vcPageN = 1;
    if (!Array.isArray(vcRows) || !vcRows.length) { box.innerHTML = '<p class="hint">该运行无病毒 contig 记录</p>'; return; }
    const hf = $('vcHostF');
