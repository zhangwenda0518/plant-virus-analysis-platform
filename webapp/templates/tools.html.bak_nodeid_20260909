  Plotly.newPlot('csCovPlot', [{
    x: arr.map((_, i) => i + 1), y: arr, type: 'scatter', mode: 'lines',
    line: { width: 1, color: '#1976d2' }, fill: 'tozeroy',
    fillcolor: 'rgba(25,118,210,0.18)', name: '深度',
  }], {
    margin: { l: 50, r: 16, t: 16, b: 40 },
    xaxis: { title: '位置（分箱）' },
    yaxis: { title: '平均深度' },
    height: 300,
  }, { displayModeBar: false, responsive: true });
}

