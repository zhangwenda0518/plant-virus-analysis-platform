function kvTable(rows, cols, empty) {
  if (!rows || !rows.length) return `<p class="hint">${empty || '无记录'}</p>`;
  const th = cols.map(c => `<th>${esc(c[0])}</th>`).join('');
  const tr = rows.map(r => '<tr>' + cols.map(c => {
    let v = r[c[1]];
    if (v === undefined || v === null || v === '') v = '';
    else if (typeof v === 'number') v = v.toLocaleString();
    return `<td title="${esc(String(v))}">${esc(String(v))}</td>`;
  }).join('') + '</tr>').join('');
  return `<table class="tbl"><thead><tr>${th}</tr></thead><tbody>${tr}</tbody></table>`;
}

function renderKvsuite(d) {
  const s = d.summary || {};
  const vsum = s.variant || {};
  const nSkip = vsum.n_skipped || 0;
  const badges = [
    `鉴定命中 ${s.n_identify || 0}`,
    `确认存在 ${s.n_filtered || 0}`,
    `被剔除 ${s.n_discarded || 0}`,
    `共识 QC ${s.n_consensus || 0}`,
    `变异位点 ${s.n_variants || 0}`,
    `变异图 ${s.n_variant_plots || (d.variant_plots || []).length}`,
    `深度图 ${(d.plots || []).length}`,
    `演化图 ${s.n_evo_plots || (d.evo_plots || []).length}`,
  ].map(t => `<span style="padding:2px 10px;border-radius:10px;background:#e3f2fd;font-size:11px;margin-right:6px">${esc(t)}</span>`);
  // viroid 等无编码基因的参考会被 SnpEff 跳过，属于正常情形，单独标出
  if (nSkip) {
    badges.push(`<span title="viroid 等无 CDS/gene 注释，SnpEff 不适用" style="padding:2px 10px;border-radius:10px;background:#fff3e0;font-size:11px;margin-right:6px">跳过注释 ${nSkip}</span>`);
  }
  $('kvSummary').innerHTML = badges.join('');

  // 列名必须与后端产物的真实表头一致：
  // identify/identify/all_viruses.summary.tsv（Sample/Accession/Species/
  //   Molecule_Type2/Length/Coverage(%)/MeanDepth/Uniq_Reads/EM_Reads/taxid）
  // filter/filtered.tsv 同上 + Segment/is_segmented
  // consensus/consensus_qc.tsv（Sample/Reference/Feature/Gene/Length/
  //   N_ratio(%)/Stops/QC）
  const idCols = [['样品', 'Sample'], ['参考', 'Accession'], ['物种', 'Species'],
    ['分子类型', 'Molecule_Type2'], ['长度', 'Length'], ['覆盖%', 'Coverage(%)'],
    ['平均深度', 'MeanDepth'], ['reads', 'Uniq_Reads'], ['EM reads', 'EM_Reads'],
    ['taxid', 'taxid']];
  $('kvIdentifyTable').innerHTML = kvTable(d.identify, idCols, '无鉴定结果');

  const fCols = [['样品', 'Sample'], ['参考', 'Accession'], ['物种', 'Species'],
    ['片段', 'Segment'], ['分节段', 'is_segmented'], ['长度', 'Length'],
    ['覆盖%', 'Coverage(%)'], ['平均深度', 'MeanDepth'],
    ['reads', 'Uniq_Reads'], ['EM reads', 'EM_Reads']];
  $('kvFilteredTable').innerHTML = kvTable(d.filtered, fCols, '无通过过滤的记录');

  const cCols = [['样品', 'Sample'], ['参考', 'Reference'], ['ORF', 'Feature'],
    ['基因', 'Gene'], ['长度', 'Length'], ['N 占比%', 'N_ratio(%)'],
    ['终止子', 'Stops'], ['QC', 'QC']];
  $('kvConsensusTable').innerHTML = kvTable(d.consensus_qc, cCols, '无共识 QC 记录');

  // 列名必须与 kv_variant.ANN_COLS 一致（CHROM/POS/REF/ALT/Gene_Name/
  // Annotation/Impact/HGVS_c/HGVS_p/AA/CDS/Feature_ID/Note），
  // QUAL/DP/AF 由后端从同名 vcf 补齐。
  const vCols = [['基因组', 'genome'], ['位置', 'POS'], ['参考', 'REF'],
    ['变异', 'ALT'], ['基因', 'Gene_Name'], ['效应', 'Annotation'],
    ['影响', 'Impact'], ['HGVS.c', 'HGVS_c'], ['氨基酸', 'HGVS_p'],
    ['AA', 'AA'], ['CDS', 'CDS'], ['质量', 'QUAL'], ['深度', 'DP'],
    ['频率', 'AF']];
  const variantRows = (d.variants || []).map(r => {
    const o = Object.assign({}, r);
    if (o.AF !== undefined && o.AF !== null && o.AF !== '') {
      const f = parseFloat(o.AF);
      if (!isNaN(f)) o.AF = f.toFixed(3);
    }
    if (o.QUAL !== undefined && o.QUAL !== null && o.QUAL !== '') {
      const q = parseFloat(o.QUAL);
      if (!isNaN(q)) o.QUAL = q.toFixed(1);
    }
    return o;
  });
  $('kvVariantTable').innerHTML = kvTable(variantRows, vCols, '无变异注释记录');

  renderKvVariantPlots(d);
  renderKvEvo(d);

  const plots = d.plots || [];
  $('kvPlots').innerHTML = plots.length
    ? plots.map(p => `<div style="margin-bottom:8px"><a href="/tool_runs/${encodeURIComponent(d.run)}/${p.split('/').map(encodeURIComponent).join('/')}" target="_blank" class="mono" style="font-size:11.5px">${esc(p)}</a></div>`).join('')
    : '<p class="hint">无深度图（可能未跑绘图段，或过滤后无确认病毒）</p>';
}

/* 变异可视化图内联展示（点缩略图放大，或走 /tool_runs/<run>/<path> 下载） */
function renderKvVariantPlots(d) {
  const box = $('kvVariantPlots');
  if (!box) return;
  const run = d.run || '';
  const files = d.variant_plots || [];
  if (!files.length) {
    box.innerHTML = '<p class="hint">无变异图（可能该样本无变异记录，或 SnpEff 对全部参考均不适用）</p>';
    return;
  }
  // 分两类：overview 主图单独一行放大，其余缩略图平铺
  const overview = files.filter(f => /_overview\.png$/i.test(f));
  const others = files.filter(f => !/_overview\.png$/i.test(f));
  const url = f => `/tool_runs/${encodeURIComponent(run)}/kvsuite/variant_plots/${encodeURIComponent(f)}`;
  const pdfUrl = f => url(f.replace(/\.png$/i, '.pdf'));

  const parts = [];
  overview.forEach(f => {
    const label = f.replace(/_overview\.png$/i, '');
    parts.push(`<div style="margin-bottom:14px">
      <div class="mono" style="font-size:11px;margin-bottom:4px">${esc(label)} · 三联主图</div>
      <img src="${url(f)}" alt="${esc(label)} variant overview"
           style="width:100%;max-width:900px;border:1px solid #e0e0e0;border-radius:4px;background:#fff;cursor:zoom-in"
           onclick="window.open('${url(f)}','_blank')">
      <div style="margin-top:4px"><a class="mono" style="font-size:10.5px" href="${pdfUrl(f)}" target="_blank">下载 PDF</a></div>
    </div>`);
  });
  if (others.length) {
    parts.push('<div style="display:flex;flex-wrap:wrap;gap:12px">');
    others.forEach(f => {
      const label = f.replace(/\.png$/i, '').replace(/^[^_]*_/, '');
      parts.push(`<div style="flex:0 0 320px">
        <img src="${url(f)}" alt="${esc(label)}"
             style="width:100%;border:1px solid #e0e0e0;border-radius:4px;background:#fff;cursor:zoom-in"
             onclick="window.open('${url(f)}','_blank')">
        <div class="mono" style="font-size:10.5px;margin-top:3px;color:#666">${esc(label)}</div>
      </div>`);
    });
    parts.push('</div>');
  }
  box.innerHTML = parts.join('');
}

/* 突变演化分析（三模块）图与表内联展示 */
function renderKvEvo(d) {
  const box = $('kvEvoPlots');
  if (!box) return;
  const run = d.run || '';
  const files = d.evo_plots || [];
  const man = d.evo_manifest || {};
  const sbadge = $('kvEvoSummary');
  const tbox = $('kvEvoTables');
  if (sbadge) {
    const snps = (man.snpgenie || []).length;
    const skipped = (man.skipped || []).length;
    const bits = [`${man.n_accessions || 0} 条参考`, `${files.length} 张图`];
    if (snps) bits.push(`SNPGenie ${snps} 条`);
    if (skipped) bits.push(`跳过 ${skipped}`);
    sbadge.innerHTML = bits.map(t => `<span style="padding:2px 10px;border-radius:10px;background:#e8f5e9;font-size:11px;margin-right:6px">${esc(t)}</span>`).join('');
  }
  if (!files.length) {
    box.innerHTML = '<p class="hint">无演化分析图（可能该样本无变异记录，或未开启扩展变异分析）</p>';
  } else {
    const MODS = [
      ['spectrum', 'A', '分子突变谱（Ts/Tv · AFS · 等位频率分布）'],
      ['landscape', 'A', '突变景观（位点平均等位频率）'],
      ['density', 'B', '变异密度与基因组分布（KDE + 滑窗 + 基因轨道）'],
      ['popgen', 'C', "群体遗传学（πN/πS · 滑窗 π · Tajima's D）"],
      ['snpgenie', 'D', 'SNPGenie 位点/密码子层变异（变异类别分布 · N/S 密码子差异）']
    ];
    const byAcc = {};
    files.forEach(f => {
      const m = f.match(/^(.+?)_evo_(spectrum|landscape|density|popgen|snpgenie)\.png$/i);
      if (!m) return;
      (byAcc[m[1]] = byAcc[m[1]] || {})[m[2].toLowerCase()] = f;
    });
    const accs = Object.keys(byAcc).sort();
    const url = f => `/tool_runs/${encodeURIComponent(run)}/kvsuite/variant_plots/${encodeURIComponent(f)}`;
    const out = [];
    MODS.forEach(([mod, tag, title]) => {
      const hits = accs.filter(a => byAcc[a][mod]);
      if (!hits.length) return;
      out.push(`<div style="margin:6px 0 18px">
        <div style="font-size:12px;font-weight:600;margin-bottom:6px">模块 ${esc(tag)} · ${esc(title)}</div>`);
      hits.forEach(a => {
        const f = byAcc[a][mod];
        out.push(`<div style="margin-bottom:14px">
          <div class="mono" style="font-size:11px;margin-bottom:4px">${esc(a)}</div>
          <img src="${url(f)}" alt="${esc(a)} ${esc(mod)}"
               style="width:100%;max-width:900px;border:1px solid #e0e0e0;border-radius:4px;background:#fff;cursor:zoom-in"
               onclick="window.open('${url(f)}','_blank')">
          <div style="margin-top:4px"><a class="mono" style="font-size:10.5px" href="${url(f.replace(/\.png$/i, '.pdf'))}" target="_blank">下载 PDF</a></div>
        </div>`);
      });
      out.push('</div>');
    });
    box.innerHTML = out.join('');
  }

  if (!tbox) return;
  const prods = d.snpgenie_products || {};
  const accs2 = Object.keys(prods).sort();
  if (!accs2.length) { tbox.innerHTML = ''; return; }
  const chunks = ['<div style="font-size:12px;font-weight:600;margin-bottom:6px">SNPGenie 每 ORF 多样性与选择压力</div>'];
  const cols = [['ORF', 'product'], ['πN', 'piN'], ['πS', 'piS'],
                ['N位点', 'N_sites'], ['S位点', 'S_sites'], ['dN/dS', null]];
  const fmt = v => (v === undefined || v === null || v === '' || v === '*') ? '—'
    : (typeof v === 'number' ? v.toFixed(6) : String(v));
  accs2.forEach(acc => {
    const rows = prods[acc] || [];
    if (!rows.length) return;
    const body = rows.map(r => {
      const piN = parseFloat(r.piN), piS = parseFloat(r.piS);
      const nd = parseFloat(r.N_diffs), sd = parseFloat(r.S_diffs);
      const noPoly = (nd === 0 && sd === 0);
      // ORF 内变异数：区分「该 ORF 侧翼无变异」与「有变异但样本内不多态」
      const nIn = parseInt(r.N_VARIANTS_IN_ORF, 10);
      const covered = (r.ORF_COVERED === 'True' || r.ORF_COVERED === 'true' || r.ORF_COVERED === true);
      let ratio;
      if (!noPoly && isFinite(piN) && isFinite(piS) && piS > 0) {
        ratio = (piN / piS).toFixed(3);
      } else if (noPoly && isFinite(nIn) && nIn === 0) {
        // 该 ORF 区域内一个变异都没调到，不能断言「不多态」
        ratio = '无变异检出';
      } else if (noPoly && isFinite(nIn)) {
        ratio = `无多态(位点${nIn})`;
      } else if (noPoly) {
        ratio = '无多态';
      } else {
        ratio = 'πS=0';
      }
      const tds = cols.map(([, key]) => {
        if (key === null) return `<td>${esc(ratio)}</td>`;
        let v = r[key];
        if (key === 'piN' || key === 'piS' || key === 'N_sites' || key === 'S_sites') v = parseFloat(v);
        return `<td>${esc(fmt(v))}</td>`;
      }).join('');
      return `<tr>${tds}</tr>`;
    }).join('');
    chunks.push(`<div style="margin-bottom:12px">
      <div class="mono" style="font-size:11px;margin-bottom:4px">${esc(acc)}</div>
      <table class="tbl"><thead><tr>${cols.map(c => `<th>${esc(c[0])}</th>`).join('')}</tr></thead><tbody>${body}</tbody></table>
    </div>`);
  });
  chunks.push('<p class="hint" style="margin-top:-4px">dN/dS 用 πN/πS 估算。零值三态：“无变异检出”=该 ORF 区间内无变异位点（可能是保守，也可能是覆盖不足，需结合深度判断）；“无多态(位点N)”=该 ORF 内有 N 个变异位点，但均为样本内非多态（SNPGenie 计为 NONREF_NONPOLY），N_diffs=S_diffs=0；“πS=0”=πS 为零导致比值数学上不可定义。</p>');

  // 群体遗传滑窗表（每参考一张，取前若 60 行）
  const win = d.popgen_tables || {};
  const waccs = Object.keys(win).sort();
  if (waccs.length) {
    chunks.push('<div style="font-size:12px;font-weight:600;margin:16px 0 6px">群体遗传滑窗（窗口 π · Tajima\'s D）</div>');
    const wcols = [['窗口起', 'BIN_START'], ['窗口止', 'BIN_END'],
                   ['变异数', 'N_VARIANTS'], ['有效样本', 'N_EFF'],
                   ['π', 'PI'], ["Tajima's D", 'TAJIMA_D']];
    waccs.forEach(acc => {
      const rows = (win[acc] || []).slice(0, 60);
      if (!rows.length) return;
      const body = rows.map(r => '<tr>' + wcols.map(([, k]) => {
        let v = r[k];
        if (v === undefined || v === null || v === '') v = '—';
        else if (k === 'PI' || k === 'TAJIMA_D') {
          const num = parseFloat(v);
          v = isFinite(num) ? num.toFixed(5) : '—';
        }
        return `<td>${esc(v)}</td>`;
      }).join('') + '</tr>').join('');
      chunks.push(`<div style="margin-bottom:12px">
        <div class="mono" style="font-size:11px;margin-bottom:4px">${esc(acc)}</div>
        <div style="max-height:280px;overflow:auto">
        <table class="tbl"><thead><tr>${wcols.map(c => `<th>${esc(c[0])}</th>`).join('')}</tr></thead><tbody>${body}</tbody></table>
        </div>
      </div>`);
    });
  }
  tbox.innerHTML = chunks.join('');
}


