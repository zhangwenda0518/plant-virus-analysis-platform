  try {
    const r = await fetch('/api/tool/runs');
    const runs = runsWithResult((await r.json()).filter(x => x.name.startsWith('contigs_')));
    const latest = runs.length ? runs[0].name : '';
    const lb = $('anaRunLabel');
    if (!latest) {
      anaCurRun = '';
      if (lb) lb.textContent = '（先运行工具④，或到历史运行区复用）';
      return;
    }
    if (latest === anaCurRun) return;      // 无新运行：不重复加载
    anaCurRun = latest;
    if (lb) lb.textContent = latest + (render ? '' : '（点击下方的“📊 分类报告”查看）');
    if (render) loadViralContigs();
  } catch (e) { /* 忽略 */ }
}

