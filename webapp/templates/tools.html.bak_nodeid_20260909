/* 四件套分析作用域：ana = 工具④卡片内嵌表格；cdd / hom = 独立模块
   「保守域与功能元件注释（CDD）」「同源比对（BLASTN · BLASTX）」两卡片。
   两组共用 /api/tool/analyze 与结果缓存，仅 DOM 目标不同。 */
const ANA_SCOPES = {
  ana: { run: 'anaRun', wrap: 'anaResult', title: 'anaTitle', body: 'anaBody' },
  cdd: { run: 'cddRun', wrap: 'cddResult', title: 'cddTitle', body: 'cddBody' },
  hom: { run: 'homRun', wrap: 'homResult', title: 'homTitle', body: 'homBody' },
};

/* 直接输入序列模式：从文件/粘贴读取 FASTA，或运行 4 件套分析（无需选运行） */
function caSeqFromPaste(fileId) {
  const inp = $(fileId);
  if (!inp) return;
  let text = inp.value.trim();
  if (!text || (!text.startsWith('>') && !text.includes('\n'))) {
    alert('请先在文件输入框选择文件，或在下方文本框粘贴序列'); return;
  }
  // 若输入框是路径而非序列，尝试按路径读取
  if (!text.startsWith('>')) {
    toast('已在下方文本框填入序列，请确认后运行', fileId, {ttl: 3000});
  }
}
function runCaSeqInput(scope, presetAction) {
  const seqId = scope === 'cdd' ? 'cddSeqText' : 'homSeqText';
  const seqRaw = ($(seqId)?.value || '').trim();
  const fileIn = scope === 'cdd' ? 'cddSeqIn' : 'homSeqIn';
  const filePath = $(fileIn)?.value?.trim() || '';
  let seq = seqRaw
    || (filePath ? null : '');   // 文本优先；否则看文件
  if (!seq && filePath) {
    // 从文件加载：读取内容第一种记录作为序列
    seq = '__LOAD_FILE__';
  }
  if (!seq) { alert('请输入核酸序列或选择序列文件'); return; }
  // 解析 FASTA 首条记录 → contig 名 + 序列
  let name = 'input_seq', body = '';
  if (seq === '__LOAD_FILE__') {
    body = seqRaw;  // placeholder, 实际应 fetch 文件
  } else {
    const lines = seq.split('\n');
    for (const ln of lines) {
      if (ln.startsWith('>')) { name = ln.slice(1).trim().split(/\s+/)[0] || name; }
      else body += ln.trim();
    }
  }
  if (!body) { alert('未解析到序列（需 >header 开头的 FASTA）'); return; }
  const action = presetAction || 'cdd';
  runAnalyzeDirect(action, name, body, scope);
}
function runAnalyzeDirect(action, contig, seq, scope) {
  const sc = ANA_SCOPES[scope];
  $(sc.wrap).style.display = '';
  $(sc.title).textContent = `⏳ 正在运行 ${action.toUpperCase()} 分析 · ${contig}`;
  $(sc.body).innerHTML = `<div id="anadirect-${contig}" style="max-height:300px;overflow:auto;background:#0f1720;color:#d7e3ee;border-radius:6px;padding:10px;font-family:Consolas,monospace;font-size:11.5px;white-space:pre-wrap">任务已提交，正在初始化…</div>`;
  startPolling();
  fetch('/api/tool/analyze', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ run: '_seq_input', contig: contig, action: action, seq: seq })
  }).then(r => r.json()).then(d => {
    if (d.error) { alert('启动失败: ' + d.error); return; }
    if (d.cached) { laDirectCached(action, contig, seq, sc); return; }
    const tid = d.task; taskLogOpen.add(tid);
    const timer = setInterval(async () => {
      try {
        const snap = await (await fetch('/api/task/' + tid)).json();
        const box = document.getElementById('anadirect-' + contig);
        if (box) { box.textContent = (snap.msg ? `${Math.round((snap.pct||0)*100)}% ${snap.msg}\n` : '') + (snap.log || []).join('\n'); box.scrollTop = box.scrollHeight; }
        if (snap.status === 'done') {
          clearInterval(timer);
          laDirectResult(action, contig, seq, sc);
        } else if (snap.status === 'failed' || snap.status === 'cancelled') {
          clearInterval(timer);
          if (box) box.textContent += '\n[失败] ' + (snap.error || snap.status);
        }
      } catch (e) { /* 继续 */ }
    }, 3000);
  }).catch(e => alert('无法连接平台服务: ' + e));
}
async function laDirectCached(action, contig, seq, sc) {
  await laDirectResult(action, contig, seq, sc);
}
async function laDirectResult(action, contig, seq, sc) {
  try {
    const r = await fetch(`/api/tool/analysis?contig=${encodeURIComponent(contig)}&action=${action}&seq=${encodeURIComponent(seq)}`);
    if (!r.ok) { $(sc.body).innerHTML = '<p class="hint">结果查询失败（可能尚未完成）</p>'; return; }
    const res = await r.json();
