<script>
/* $ / esc / taskLogOpen / startPolling / browse 等均来自 app.js */

const MODULE_NAV = {{ nav_groups | tojson }};

let activeModuleGroup = 'sample';

function currentGroupFromURL() {
  const g = new URLSearchParams(location.search).get('g');
  if (g && MODULE_NAV.some(x => x.id === g)) return g;
  const hash = (location.hash || '').replace('#', '');
  const hit = MODULE_NAV.find(gr => gr.items.some(i => i.id === hash));
  return hit ? hit.id : null;
}

function syncTopNav(groupId) {
  /* 顶部导航一级高亮随页内组切换同步（/tools 下服务端无法区分组） */
  document.querySelectorAll('.topnav .navlinks a[data-group]').forEach(a => {
    a.classList.toggle('active', a.dataset.group === groupId);
  });
}

function renderModuleTree() {
  const sub = $('moduleSubList');
  const home = $('gtHome');
  if (!sub || !home) return;
  const hash = (location.hash || '').replace('#', '');
  activeModuleGroup = currentGroupFromURL() || activeModuleGroup || 'sample';
  const group = MODULE_NAV.find(g => g.id === activeModuleGroup) || MODULE_NAV[0];
  syncTopNav(group.id);
  // 页面布局规范：右侧 = 当前模块工作区（一次只显示一个二级模块）。
  // ref 条目 = 指向已有工作区的别名菜单（如 保守域分析 → 工具④卡片）。
  // 纯链接组（数据资源/结果中心/溯源与提交）显示落地卡片。
  const resolveRef = id => {
    for (const g of MODULE_NAV)
      for (const it of g.items)
        if (it.id === id) return it.ref || it.id;
    return id;
  };
  const localItems = group.items.filter(i => i.id);
  const hashKey = localItems.some(i => i.id === hash) ? hash : '';
  home.textContent = `🏠 ${group.label}`;
  home.href = `/tools?g=${group.id}`;
  home.title = `返回 ${group.label} 组概览`;
  sub.innerHTML = group.items.map(item => {
    const isLocal = !!item.id;
    const on = isLocal && item.id === hashKey ? ' on' : '';
    const href = item.href || `#${item.id}`;
    return `<a class="gt-item${on}" href="${href}"${isLocal ? ` data-item="${esc(item.id)}"` : ''} title="${esc(item.desc || '')}">${esc(item.title)}</a>`;
  }).join('');
  sub.querySelectorAll('.gt-item[data-item]').forEach(el => {
    el.addEventListener('click', ev => {
      ev.preventDefault();
      history.replaceState(null, '', '#' + el.dataset.item);
      renderModuleTree();
    });
  });
  if (hashKey && document.getElementById(resolveRef(hashKey))) {
    showModule(resolveRef(hashKey));
  } else {
    /* 未选中具体二级模块：统一显示组落地卡片，点击卡片/胶囊再进入模块（各组行为一致） */
    showLanding(group);
  }
}

function showModule(id) {
  /* 工作区只显示当前二级模块；main 下其余元素（含游离标题）一律隐藏。
     顶部二级模块切换条（#moduleTree）与落地卡片容器除外。 */
  const main = document.querySelector('main');
  const landing = $('groupLanding');
  const strip = $('moduleTree');
  if (landing) landing.style.display = 'none';
  if (!main) return;
  main.querySelectorAll(':scope > *').forEach(el => {
    if (el === landing || el === strip) return;
    el.style.display = el.id === id ? '' : 'none';
  });
}

function showLanding(group) {
  /* 组落地卡片视图：所有组统一「先总览、点击进入」；本地模块卡片点击切 hash */
  const main = document.querySelector('main');
  const landing = $('groupLanding');
  const strip = $('moduleTree');
  if (!main || !landing) return;
  main.querySelectorAll(':scope > *').forEach(el => {
    if (el !== landing && el !== strip) el.style.display = 'none';
  });
  landing.innerHTML = group.items.map(item => {
    const href = item.href || ('#' + item.id);
    return `<a class="landing-item card" href="${esc(href)}"${item.id ? ` data-item="${esc(item.id)}"` : ''}>
      <b>${esc(item.title)}</b>
      <span class="hint">${esc(item.desc || '')}</span>
    </a>`;
  }).join('');
  landing.querySelectorAll('a[data-item]').forEach(el => {
    el.addEventListener('click', ev => {
      ev.preventDefault();
      history.replaceState(null, '', '#' + el.dataset.item);
      renderModuleTree();
    });
  });
  landing.style.display = '';
}

window.addEventListener('hashchange', () => renderModuleTree());

function showRows() {
  const ty = $('i_type').value;
  $('row_i2').style.display = ty === 'pe' ? '' : 'none';
  $('f_input_label').textContent =
    ty === 'fasta' ? 'contigs / 序列 FASTA'
      : (ty === 'pe' ? 'R1 FASTQ' : 'FASTQ（单端）');
}

function val(id) { return ($(id)?.value || '').trim(); }

async function runTool(tool, btn) {
  let params = {}, threads = null;
  if (tool === 'fastp') {
    if (!val('f_r1')) { alert('请选择 R1 FASTQ'); return; }
    params = { r1: val('f_r1'), r2: val('f_r2'), dedup: !!$('f_dedup').checked };
    threads = +val('f_threads') || null;
  } else if (tool === 'identify') {
    if (!val('i_input')) { alert('请选择输入文件'); return; }
    params = { input: val('i_input'), input2: val('i_input2'),
               input_type: $('i_type').value,
               confidence: +val('i_conf') || 0,
               db_virus: val('i_vdb') || 'virus' };
    threads = +val('i_threads') || null;
  } else if (tool === 'assemble') {
    if (!val('a_r1') || !val('a_r2')) { alert('请选择 R1 / R2 FASTQ'); return; }
    params = { r1: val('a_r1'), r2: val('a_r2'), mode: $('a_mode').value,
               memory: +val('a_mem') || 64, min_len: +val('a_minlen') || 200 };
    threads = +val('a_threads') || null;
  } else if (tool === 'convert') {
    if (!val('cv_input')) { alert('请选择输入文件'); return; }
    params = { input: val('cv_input'), target: $('cv_target').value };
  } else {
    if (!val('c_fa')) { alert('请选择 contigs FASTA'); return; }
    params = { contigs: val('c_fa'), min_len: +val('c_minlen') || 200,
               confidence: +val('c_conf') || 0,
               db_virus: val('c_vdb') || 'virus',
               };
    threads = +val('c_threads') || null;
  }
  try {
    const r = await fetch('/api/tool/run', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tool, threads, params })});
    if (!r.ok) { alert('启动失败: ' + ((await r.json()).error || '')); return; }
    const d = await r.json();
    // 工具②启动成功即记住本次运行名（完成后 refreshLastIdentRun 再校正为列表最新）
    if (tool === 'identify' && d.run) lastIdentRun = d.run;
    taskLogOpen.add(d.task);
    startPolling();
    $('tasks')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    watchTaskBtn(d.task, btn, '⏳ 运行中…', () => {
      // 工具④运行完成：刷新并自动内嵌分类报告（运行完成后才展示）
      if (tool === 'contigs') loadAnaRuns(true);
      // 工具②运行完成：刷新「最近鉴定运行名」并自动内联展示分类报告
      if (tool === 'identify') { loadToolRuns(); refreshLastIdentRun(); if (lastIdentRun) openIdentReport(); }
    });
  } catch (e) { alert('无法连接平台服务: ' + e); }
}

async function loadToolRuns() {
  /* 「🗂 最近专项运行」底部区块已移除（运行记录直接平铺在各工具卡内）；
     函数保留为无害空操作（refreshTasks 结束通知等仍可能调用）。 */
  const box = $('toolRuns');
  if (!box) return;
  try {
    const r = await fetch('/api/tool/runs');
    const runs = await r.json();
    if (!runs.length) {
      box.innerHTML = '<p class="hint">暂无运行记录（产物在平台目录 tool_runs/ 下）</p>';
      return;
    }
    box.innerHTML = runs.map(run => {
      const files = (run.files || []).map(f =>
        `<div class="fitem">📄 ${esc(f.path)} <span class="hint">${esc(f.size)}</span></div>`
      ).join('');
      return `<div class="card" style="margin-bottom:12px">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <b>${esc(run.name)}</b>
          <button class="btn small" onclick="openToolRun('${esc(run.name)}')">📂 打开目录</button>
        </div>
        <div style="max-height:150px;overflow:auto;margin-top:8px">${files || '<p class="hint">（无文件）</p>'}</div>
      </div>`;
    }).join('');
  } catch (e) { box.innerHTML = '<p class="hint">加载失败</p>'; }
}

async function openToolRun(name) {
  try {
    await fetch('/api/tool/open', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name })});
  } catch (e) { alert('打开失败: ' + e); }
}

// ---------------- 工具② 分类报告（内联渲染：fetch report_data + 页内 Plotly，绘制函数与工具④共用） ----------------
let lastIdentRun = '';   // 本页最近一次鉴定运行名（启动成功时记录，完成后校正为列表最新）
let RPTI = null;         // 工具② 报告数据缓存（/api/tool/report_data 返回）

/* 从运行列表取最近一次 identify_* 运行名，填入「最近鉴定运行名」输入框 */
async function refreshLastIdentRun() {
  const inp = $('identRun');
  if (!inp) return;
  try {
    const r = await fetch('/api/tool/runs');
    const runs = await r.json();
    const hit = runs.find(x => x.name.startsWith('identify_'));
    if (hit) inp.value = hit.name;
  } catch (e) { /* 忽略 */ }
}

/* 打开工具②的分类报告：拉取 JSON 数据后页内渲染（Sankey + 分类表，不再 iframe 嵌套） */
async function openIdentReport() {
  const run = ($('identRun') && $('identRun').value.trim()) || lastIdentRun;
  if (!run) { alert('请先运行一次鉴定，或填写运行名（tool_runs/ 下 identify_* 目录名）'); return; }
  try {
    const r = await fetch('/api/tool/report_data?run=' + encodeURIComponent(run));
    if (!r.ok) { alert('报告数据加载失败: ' + ((await r.json()).error || '')); return; }
    RPTI = await r.json();
    $('identReport').style.display = '';
    $('identReport')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    renderRptI();
  } catch (e) { alert('无法连接平台服务: ' + e); }
}

// ---------------- 分类报告内联渲染共用函数（工具②④共用：行过滤 / Sankey / 分类表） ----------------

/* Sankey 节点配色（32-server 口径；未列出的分类单元用默认蓝） */
const RPT_NODE_COLORS = {
  root: '#d4d4d4', Viruses: '#e41a1c', Riboviria: '#377eb8', Orthornavirae: '#4daf4a',
  Kitrinoviricota: '#984ea3', Alsuviricetes: '#ff7f00', Martellivirales: '#a65628',
  Virgaviridae: '#f781bf'
};
/* 视为「标准层级」的 rank（分类表中加粗显示） */
const RPT_STD_RANKS = new Set(['superkingdom', 'kingdom', 'phylum', 'class', 'order',
  'family', 'genus', 'species']);

/* 每属只保留 count 前 5 的种（32-server 口径）：depth 栈回溯归属，
   被删掉的种及其更深后代一并丢弃；无属祖先的种不做 top5 限制 */
function limitSpeciesPerGenus(rows, n) {
  n = n || 5;
  const stack = [];              // 祖先行栈（depth 自浅到深）
  const genusSpe = new Map();    // genus 行 → 该属 species 行列表
  const speOfDeep = new Map();   // species 的更深后代行 → 所属 species 行
  const noGenus = new Set();     // 无属祖先的 species 行（始终保留）
  for (const r of rows) {
    while (stack.length && stack[stack.length - 1].depth >= r.depth) stack.pop();
    const anc = [...stack].reverse();            // 深 → 浅
    const genusAnc = anc.find(a => a.rank === 'genus');
    const speAnc = anc.find(a => a.rank === 'species');
    if (r.rank === 'genus') genusSpe.set(r, []);
    else if (r.rank === 'species') { if (genusAnc) genusSpe.get(genusAnc).push(r); else noGenus.add(r); }
    else if (speAnc) speOfDeep.set(r, speAnc);   // 比 species 更深的行记归属
    stack.push(r);
  }
  const kept = new Set();        // 每属 count 前 5 的种
  for (const spes of genusSpe.values()) {
    spes.slice().sort((a, b) => (b.count || 0) - (a.count || 0)).slice(0, n)
        .forEach(s => kept.add(s));
  }
  return rows.filter(r => {
    if (r.rank === 'species') return kept.has(r) || noGenus.has(r);
    if (speOfDeep.has(r)) return kept.has(speOfDeep.get(r));
    return true;
  });
}

/* kreport 行过滤：unclassified 按开关保留；no rank 仅留 root；可选每属 top5 种 */
function filterRptRows(rows, showUnc, top5) {
  let out = (rows || []).filter(r => {
    if (r.rank === 'unclassified') return !!showUnc;
    if (r.rank === 'no rank') return r.name === 'root';
    return true;
  });
  return top5 ? limitSpeciesPerGenus(out, 5) : out;
}

/* 由过滤后的行构建 Sankey 的 {nodes, links}：
   depth 栈回溯父子；同名节点只建一次（去重 idx）；同父同子重复边合并累加 count */
function buildSankey(rows) {
  const idx = new Map();         // 节点名 → 下标（同名去重）
  const nodes = [], links = [];
  const nodeId = name => {
    if (!idx.has(name)) { idx.set(name, nodes.length); nodes.push(name); }
    return idx.get(name);
  };
  const edge = new Map();        // "父→子" → 累计 count
  const stack = [];
  for (const r of rows) {
    while (stack.length && stack[stack.length - 1].depth >= r.depth) stack.pop();
    if (stack.length) {
      const key = stack[stack.length - 1].name + '→' + r.name;
      edge.set(key, (edge.get(key) || 0) + (r.count || 0));
    }
    stack.push(r);
  }
  edge.forEach((v, k) => {
    const [s, t] = k.split('→');
    links.push({ source: nodeId(s), target: nodeId(t), value: v });
  });
  return { nodes, links };
}

/* 渲染 Plotly Taxonomy Sankey（横向；节点按分类单元着色） */
function drawSankey(rows, divId) {
  const { nodes, links } = buildSankey(rows);
  Plotly.newPlot(divId, [{
    type: 'sankey', orientation: 'h',
    node: { pad: 20, thickness: 25, line: { color: '#999', width: 0.5 },
            label: nodes, color: nodes.map(n => RPT_NODE_COLORS[n] || '#2e86c1') },
    link: { source: links.map(l => l.source), target: links.map(l => l.target),
            value: links.map(l => l.value), color: 'rgba(46,134,193,0.15)' },
    textfont: { size: 11 }
  }], { margin: { l: 8, r: 8, t: 8, b: 8 }, font: { size: 11 } },
       { responsive: true, displayModeBar: false });
}

/* 渲染分类表：no rank 灰显、标准层级加粗、Taxon 按 depth 缩进 */
