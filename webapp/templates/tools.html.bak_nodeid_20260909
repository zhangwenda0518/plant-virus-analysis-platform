async function runConsensus(btn) {
  const run = val('cs_run');
  const fa = val('cs_fa');
  const kvrun = val('cs_kvrun');
  const kvrefs = csKvSelected();
  if (!run && !fa && !kvrefs.length) {
    alert('请选择 contig 分类运行、kvsuite 运行参考，或输入参考 FASTA');
    return;
  }
  const params = {
    run: run || undefined,
    fasta: fa || undefined,
    kv_run: kvrefs.length ? kvrun : undefined,
    kv_refs: kvrefs.length ? kvrefs.join(',') : undefined,
    reuse_bam: (($('cs_map_mode') || {}).value === 'reuse')
      ? (($('cs_reuse_bam') || {}).value || undefined) : undefined,
    reads_src: $('cs_reads_src').value,
    reads: val('cs_reads') || undefined,
    min_qual: +val('cs_min_qual') || 20,
    min_depth: +val('cs_min_depth') || 10,
    min_freq: +val('cs_min_freq') || 0.5,
    ambig: val('cs_ambig') || 'N',
    min_mapq: +val('cs_min_mapq') || 10,
    min_minor_freq: +val('cs_minor_freq') || 0.02,
    min_cov_pct: +val('cs_min_cov') || 10,
