/* ---------- 汇总目录结果渲染 ---------- */
async function loadChainResult(chain, run) {
  try {
    let url = '/api/tool/chain_result?chain=' + encodeURIComponent(chain);
    if (run) url += '&run=' + encodeURIComponent(run);
    const r = await fetch(url);
    if (!r.ok) { alert('读取失败'); return; }
    const d = await r.json();
    if (!d.run) { alert('暂无该一键流程的运行记录'); return; }
    const isVc = chain === 'virchain';
    const box = isVc ? 'vcResult' : 'kvChainResult';
    const btn  = isVc ? 'vcTitle'  : 'kvcTitle';
    const steps= isVc ? 'vcSteps'  : 'kvcSteps';
    const ent  = isVc ? 'vcEntries': 'kvcEntries';
    $(box).style.display = 'block';
    $(btn).textContent = (isVc ? '一键分析结果' : '一键全流程汇总') + ' · ' + d.run;
    renderChainSteps($(steps), d.meta, d.run);
    renderChainEntries($(ent), d.entries, d.run);
  } catch (e) { alert('读取失败: ' + e); }
}

function renderChainSteps(el, meta, run) {
  const steps = (meta && meta.steps) || [];
  if (!steps.length) { el.innerHTML = '<p class="hint">无步骤记录</p>'; return; }
  const rows = steps.map((s, i) => {
    const skip = s.skipped ?
      '<span style="color:#888">已跳过：' + esc(s.skipped) + '</span>' :
      (s.run ? '<code>' + esc(s.run) + '</code>' : '<span style="color:#888">未运行</span>');
    const sum = s.summary && Object.keys(s.summary).length ?
      Object.entries(s.summary).map(([k, v]) =>
        '<span style="margin-left:10px;color:var(--fg-2,#555)">' + esc(k) + '=' + esc(String(v)) + '</span>'
      ).join('') : '';
    return '<tr><td style="padding:4px 8px;white-space:nowrap">' + (i + 1) + '</td>' +
           '<td style="padding:4px 8px;white-space:nowrap">' + esc(s.title || s.key) + '</td>' +
           '<td style="padding:4px 8px">' + skip + sum + '</td></tr>';
  }).join('');
  el.innerHTML = '<table style="border-collapse:collapse;width:100%;font-size:13px">' +
    '<thead><tr style="text-align:left;border-bottom:1px solid var(--line-200,#ddd)">' +
    '<th style="padding:4px 8px">#</th><th style="padding:4px 8px">步骤</th>' +
    '<th style="padding:4px 8px">运行 / 摘要</th></tr></thead><tbody>' + rows + '</tbody></table>';
}

function renderChainEntries(el, entries, run) {
  if (!entries || !entries.length) { el.innerHTML = '<p class="hint">汇总目录为空</p>'; return; }
  const rows = entries.map(e =>
    '<tr><td style="padding:4px 8px">' + (e.is_dir ? '📁' : '📄') + ' ' +
    '<code>' + esc(e.name) + '</code>' +
    (e.is_link ? ' <span style="color:#2a7;font-size:11px">符号链接</span>' : '') +
    '</td><td style="padding:4px 8px;color:var(--fg-2,#666)">' +
    esc(e.size || '') + '</td></tr>').join('');
  el.innerHTML = '<table style="border-collapse:collapse;width:100%;font-size:13px">' +
    '<tbody>' + rows + '</tbody></table>' +
    '<p class="hint" style="margin-top:8px">汇总目录：tool_runs/' + esc(run) +
    '（可直接在资源管理器打开，链接指向各步真实运行目录）</p>';
}

/* 鉴定库下拉：数据源为 /api/kv_index_list（build 页建好的库） */
async function loadKvIndexOptions() {
  const sel = $('kv_index_dir');
  if (!sel) return;
  const keep = sel.value;
  try {
    const d = await (await fetch('/api/kv_index_list')).json();
    const engs = d.engines || {};
    const opts = ['<option value="">不指定（默认/临时）</option>'];
    (d.libs || []).forEach(l => {
      const mf = l.manifest || {};
      const ref = mf.reference ? String(mf.reference).split(/[\\/]/).pop() : '';
      const eng = [l.minibwa ? 'minibwa' : '', l.salmon ? 'salmon' : '']
        .filter(Boolean).join('+');
      const tail = [eng, ref].filter(Boolean).join(' · ');
      opts.push(`<option value="${esc(l.path)}">${esc(l.name)}${tail ? '（' + esc(tail) + '）' : ''}</option>`);
    });
    sel.innerHTML = opts.join('');
    if (keep && Array.from(sel.options).some(o => o.value === keep)) sel.value = keep;
    // 引擎可用性提示
    const miss = ['minibwa', 'salmon'].filter(e => !(engs[e] || {}).available);
    if (miss.length) sel.title = '不可用引擎: ' + miss.join(', ');
  } catch (e) {}
}

