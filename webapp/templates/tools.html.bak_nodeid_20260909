/* 点 Contig ID → 复制该序列（FASTA 格式）到剪贴板 */
async function copyContigSeq(contig) {
  const run = anaCurRun;
  if (!run) { alert('请先选择运行'); return; }
  const tryFetch = async f => {
    try {
      const r = await fetch(`/tool_runs/${encodeURIComponent(run)}/${f}`);
      if (!r.ok) return null;
      return await r.text();
    } catch (e) { return null; }
  };
  let text = await tryFetch('viral_contigs.fasta');
  if (text == null) text = await tryFetch('contigs.filtered.fasta');
  if (text == null) { toast('未找到序列文件', run, { ttl: 3000 }); return; }
  const rec = (text.split('>').map(s => s.trim()).filter(Boolean)
    .find(s => s.split('\n')[0].split(/\s/)[0] === contig));
  if (!rec) { toast('序列不存在', contig, { ttl: 3000 }); return; }
  const fasta = '>' + rec.split('\n')[0] + '\n'
    + rec.split('\n').slice(1).join('\n') + '\n';
  try {
    await navigator.clipboard.writeText(fasta);
  } catch (e) {
    const ta = document.createElement('textarea');
    ta.value = fasta; document.body.appendChild(ta);
    ta.select(); document.execCommand('copy'); ta.remove();
  }
  toast('已复制序列', contig + '（' + (fasta.length - fasta.split('\n')[0].length - 1) + ' bp）', { ttl: 3000 });
}

/* 分类表动作 → 跳转「病毒注释分析」并自动运行
   cdd → t-cdd 卡；blastn / blastx → t-hom 卡 */
function anaJump(action, contig) {
  const run = anaCurRun;
  if (!run) { alert('请先选择运行'); return; }
  const target = action === 'cdd' ? '#t-cdd' : '#t-hom';
  const scope = action === 'cdd' ? 'cdd' : 'hom';
  try { sessionStorage.setItem('vp_anajump',
    JSON.stringify({ action, run, contig, ts: Date.now() })); } catch (e) {}
  if (location.pathname === '/tools') {
    // t-cdd / t-hom 属于「病毒注释分析」组（annotate），而 contig 明细表在
    // 「病毒识别和分类分析」组（virus）。只改 hash 不会跨组；且 renderModuleTree
    // 会用 URL 的 ?g= 覆盖 activeModuleGroup，所以必须把 g 参数也改成 annotate。
    const params = new URLSearchParams(location.search);
    params.set('g', 'annotate');
    const newUrl = location.pathname + '?' + params.toString() + target;
    history.replaceState(null, '', newUrl);
    activeModuleGroup = 'annotate';
    if (typeof renderModuleTree === 'function') renderModuleTree();
    setTimeout(() => processAnaJump(), 250);
  } else {
    location.href = '/tools?g=annotate' + target;
  }
}
async function processAnaJump() {
  let j = null;
  try { j = JSON.parse(sessionStorage.getItem('vp_anajump') || 'null'); } catch (e) {}
  if (!j || Date.now() - (j.ts || 0) > 60000) { sessionStorage.removeItem('vp_anajump'); return; }
  sessionStorage.removeItem('vp_anajump');
  const scope = j.action === 'cdd' ? 'cdd' : 'hom';
  const sc = ANA_SCOPES[scope];
  const sel = $(sc.run);
  if (!sel) return;
  try {
    await loadCaRuns(scope);          // 刷新下拉（不 auto 抢选择）
    if (![...sel.options].some(o => o.value === j.run)) {
      toast('运行不在列表', j.run, { ttl: 4000 }); return;
    }
    sel.value = j.run;
    await loadCaContigs(scope);
    runAnalyze(j.action, j.contig, scope);
    const card = document.getElementById(scope === 'cdd' ? 't-cdd' : 't-hom');
    if (card) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
  } catch (e) { /* 忽略 */ }
}

