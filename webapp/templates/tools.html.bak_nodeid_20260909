/* 从 contig 级列表（含完整分类链 + host）重建 kreport 式层级报告行。
   仅保留 host 前缀匹配的 contig，按每条 contig 的分类链逐级建节点、
   统计节点下的 contig 数，并记录父子层级（供 sankey / sunburst 用）。 */
function buildReportFromContigs(contigs, hostTrack) {
  const K = ['realm', 'kingdom', 'phylum', 'class', 'order', 'family', 'genus', 'species'];
  const pick = contigs.filter(c => (c.host || '').split(' (')[0] === hostTrack);
  if (!pick.length) return [];
  // 节点：key = rank::name → {rank,name,count,parentKey,parentName,depth}
  const nodeMap = new Map();
  const keyOf = (rank, name) => rank + '::' + name;
  pick.forEach(c => {
    const chain = [];
    K.forEach(k => { const v = (c[k] || '').trim(); if (v) chain.push({ k, v }); });
    let parentKey = '', parentName = '';
    chain.forEach((seg, i) => {
      const key = keyOf(seg.k, seg.v);
      if (!nodeMap.has(key)) {
        nodeMap.set(key, { rank: seg.k, name: seg.v, count: 0, parentKey, parentName, depth: i });
      }
      nodeMap.get(key).count += 1;
      parentKey = key; parentName = seg.v;
    });
  });
  // 汇总：每层父节点 count 应含其所有子孙（对 sankey 需要子节点 count 即可，
  // 此处 count 为该层节点直接命中的 contig 数，proportion 按同级占比）
  const rows = [];
  K.forEach((k, ki) => {
    const layer = Array.from(nodeMap.values()).filter(n => n.rank === k);
    if (!layer.length) return;
    const total = layer.reduce((s, n) => s + n.count, 0);
    layer.forEach(n => {
      rows.push({ rank: k, name: n.name, taxid: '', count: n.count,
                  proportion: total ? (n.count / total * 100).toFixed(2) : 0,
                  depth: n.depth });
    });
  });
  return rows;
}

