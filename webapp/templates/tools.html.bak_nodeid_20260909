function renderConsensus(d) {
  const rows = d.rows || [];
  const s = d.summary || {};
  // 摘要徽标
  const badges = [
    `参考 ${s.n_refs || 0} 条`,
    `比对 reads ${(s.n_mapped_reads || 0).toLocaleString()}`,
    `变异位点 ${s.n_variants || 0}`,
    `SNV ${s.n_snv || 0}`,
    `iSNV ${s.n_isnv || 0}`,
    `判定存在 ${(s.present || []).length}/${s.n_refs || 0}`,
  ].map(t => `<span style="padding:2px 10px;border-radius:10px;background:#e3f2fd;font-size:11px;margin-right:6px">${esc(t)}</span>`).join('');
  $('csSummary').innerHTML = badges;

  // 覆盖统计表
  if (!rows.length) {
    $('csCovTable').innerHTML = '<p class="hint">无记录</p>';
  } else {
    const tr = rows.map(r => {
      const ok = r.present === 'yes';
      return `<tr style="background:${ok ? '#e8f5e9' : '#fff3e0'}">
        <td class="mono">${esc((r.contig || '').slice(0, 40))}</td>
        <td>${r.length}</td>
        <td>${(r.mapped_reads || 0).toLocaleString()}</td>
        <td>${r.mean_depth}</td>
        <td>${r.median_depth}</td>
        <td>${r.coverage_pct}%</td>
        <td>${r.called_pct}%</td>
        <td>${r.n_snv}</td>
        <td>${r.n_isnv}</td>
        <td><b>${ok ? '存在' : '证据不足'}</b></td>
      </tr>`;
    }).join('');
    $('csCovTable').innerHTML = `<table class="tbl"><thead><tr>
      <th>contig</th><th>长度</th><th>reads</th><th>平均深度</th><th>中位深度</th>
      <th>覆盖%</th><th>共识完整%</th><th>SNV</th><th>iSNV</th><th>判定</th>
      </tr></thead><tbody>${tr}</tbody></table>`;
  }

  // 覆盖曲线下拉
  const sel = $('csCovSel');
  sel.innerHTML = (d.cov ? Object.keys(d.cov) : [])
    .filter(k => (d.cov[k] || []).length)
    .map(k => `<option value="${esc(k)}">${esc(k.slice(0, 60))}</option>`).join('');
  drawConsensusCoverage();

  // 变异表
  const vs = d.variants || [];
  const TYPE_COLOR = { SNV: '#ffcdd2', iSNV: '#e1f5fe', ambiguous: '#fff9c4', lowcov: '#f5f5f5' };
  $('csVarTable').innerHTML = vs.length ? `<table class="tbl"><thead><tr>
      <th>contig</th><th>位置</th><th>参考</th><th>共识</th><th>深度</th>
      <th>主碱基</th><th>主频</th><th>次碱基</th><th>次频</th><th>类型</th>
      </tr></thead><tbody>${vs.map(v => {
        const t = (v.type || '').split(';');
        const tg = t.map(x => `<span style="padding:1px 6px;border-radius:8px;background:${TYPE_COLOR[x] || '#eee'};font-size:11px;margin-right:3px">${esc(x)}</span>`).join('');
        return `<tr><td class="mono">${esc((v.contig || '').slice(0, 28))}</td>
          <td>${v.pos}</td><td>${esc(v.ref_base)}</td><td><b>${esc(v.cons_base)}</b></td>
          <td>${v.depth}</td><td>${esc(v.major_base)}</td><td>${v.major_freq}</td>
          <td>${esc(v.minor_base)}</td><td>${v.minor_freq}</td><td>${tg}</td></tr>`;
      }).join('')}</tbody></table>`
    : '<p class="hint">无变异位点</p>';
}
function drawConsensusCoverage() {
  if (!CS_DATA || !CS_DATA.cov) return;
  const k = $('csCovSel').value;
  const arr = (CS_DATA.cov || {})[k] || [];
