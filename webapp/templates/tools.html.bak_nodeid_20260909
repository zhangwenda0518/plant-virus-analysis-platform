const anaPending = new Set();
async function runAnalyze(action, contig, scope) {
  const sc = ANA_SCOPES[scope || 'ana'];
  const run = sc.run === 'anaRun' ? anaCurRun : val(sc.run);
  if (!run) { alert('请先选择运行'); return; }
  const key = run + '/' + contig + '/' + action;
  try {
    // 已有缓存直接展示
    const c = await fetch(`/api/tool/analysis?run=${encodeURIComponent(run)}&contig=${encodeURIComponent(contig)}&action=${action}`);
    if (c.ok) { showAnaResult(action, contig, await c.json(), sc); return; }
  } catch (e) { /* 忽略，走提交 */ }
  if (anaPending.has(key)) { alert('该分析已在运行中'); return; }
  try {
    const r = await fetch('/api/tool/analyze', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ run, contig, action })});
    const d = await r.json();
    if (!r.ok) { alert('启动失败: ' + (d.error || '')); return; }
    if (d.cached) { showCached(action, contig, sc); return; }
    anaPending.add(key);
    const tid = d.task;
    taskLogOpen.add(tid);
    startPolling();
    // 运行中提示 + 实时日志（之前无任何反馈，用户以为没反应）
    $(sc.wrap).style.display = '';
    $(sc.title).textContent = `⏳ 正在运行 ${action.toUpperCase()} 分析 · ${contig}`;
    $(sc.body).innerHTML = `<div id="anarun-${tid}" style="max-height:300px;overflow:auto;background:#0f1720;color:#d7e3ee;border-radius:6px;padding:10px;font-family:Consolas,monospace;font-size:11.5px;white-space:pre-wrap">任务已提交，正在初始化…</div>
      <p class="hint" style="margin-top:6px">分析进行中，完成后自动展示结果；日志实时刷新。</p>`;
    const timer = setInterval(async () => {
      try {
        const snap = await (await fetch('/api/task/' + tid)).json();
        const runBox = document.getElementById('anarun-' + tid);
        if (runBox) {
          const logTxt = (snap.log || []).join('\n') || '';
          const pct = Math.round((snap.pct || 0) * 100);
          runBox.textContent = (snap.msg ? `[${pct}%] ${snap.msg}\n` : '') + logTxt;
          runBox.scrollTop = runBox.scrollHeight;
        }
        if (snap.status === 'done') {
          clearInterval(timer); anaPending.delete(key);
          const res = await (await fetch(`/api/tool/analysis?run=${encodeURIComponent(run)}&contig=${encodeURIComponent(contig)}&action=${action}`)).json();
          showAnaResult(action, contig, res, sc);
        } else if (snap.status === 'failed' || snap.status === 'cancelled') {
          clearInterval(timer); anaPending.delete(key);
          const runBox2 = document.getElementById('anarun-' + tid);
          if (runBox2) runBox2.textContent += '\n[失败] ' + (snap.error || snap.status);
          alert(`分析失败: ${snap.error || snap.status}`);
        }
      } catch (e) { /* 轮询继续 */ }
    }, 5000);
  } catch (e) { alert('无法连接平台服务: ' + e); }
}

async function showCached(action, contig, sc) {
