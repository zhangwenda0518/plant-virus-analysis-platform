  if (action === 'cdd') {
    const hs = res.hits || [];
    if (!hs.length) return `<p class="hint">最长 ORF ${res.orf_len_aa} aa · 未命中保守域</p>`;
    const L = res.orf_len_aa || 1;
    const palette = ['#1a9850', '#66bd63', '#a6d96a', '#d9ef8b', '#fee08b',
                     '#fdae61', '#f46d43', '#d73027', '#762a83', '#4575b4'];
    const segs = hs.slice(0, 10).map((h, i) => {
      const from = Math.min(parseInt(h.from) || 0, L);
      const to = Math.min(parseInt(h.to) || L, L);
      const left = 100 * from / L, w = Math.max(100 * (to - from) / L, 1.5);
      const col = palette[i % palette.length];
      return `<div class="mb-seg" title="${esc(h.short_name)} ${esc(h.from)}-${esc(h.to)} E=${esc(h.evalue)}"
        style="position:absolute;left:${left.toFixed(1)}%;width:${w.toFixed(1)}%;height:100%;
        background:${col};color:#fff;font-size:10px;font-weight:600;display:flex;align-items:center;
        justify-content:center;overflow:hidden;white-space:nowrap;cursor:default">${esc(h.short_name)}</div>`;
    }).join('');
    return `<div class="ok" style="font-weight:600;margin-bottom:6px">Conserved Domains · 最长 ORF ${res.orf_len_aa} aa · ${hs.length} 个命中</div>` +
      `<div style="position:relative;height:26px;border-radius:4px;overflow:hidden;background:#eee;margin:6px 0 10px;border:1px solid #ddd">${segs}</div>` +
      `<table style="${tblCss}"><thead><tr>
        <th style="${thCss}">#</th><th style="${thCss}">Accession</th><th style="${thCss}">Short Name</th>
        <th style="${thCss}">E-value</th><th style="${thCss}">Bit Score</th>
        <th style="${thCss}">From</th><th style="${thCss}">To</th><th style="${thCss}">Superfamily</th></tr></thead><tbody>` +
      hs.map((h, i) => `<tr ${trHover}>
        <td style="${tdCss}">${i + 1}</td>
        <td style="${tdCss}"><a href="${ncbiCdd(h.accession)}" target="_blank" rel="noopener" style="color:#1a5276">${esc(h.accession)}</a></td>
        <td style="${tdCss};font-weight:600">${esc(h.short_name)}</td>
        <td style="${tdCss};font-family:monospace">${esc(h.evalue)}</td>
        <td style="${tdCss};font-family:monospace">${esc(h.bit_score || '-')}</td>
        <td style="${tdCss};text-align:right">${esc(h.from)}</td>
        <td style="${tdCss};text-align:right">${esc(h.to)}</td>
        <td style="${tdCss}"><span class="hint">${esc(h.superfamily)}</span></td></tr>`).join('') +
      '</tbody></table>';
  }
  // blastn / blastx（metabuli 口径命中表）
  const hs = res.hits || [];
  if (!hs.length) return `<p class="hint">NCBI ${action.toUpperCase()}（限病毒）无命中</p>`;
  const bestE = Math.min(...hs.map(h => parseFloat(h.evalue) || Infinity));
  const bestI = Math.max(...hs.map(h => parseFloat(h.identity) || 0));
  const link = action === 'blastn' ? ncbiNuc : ncbiProt;
  return `<div class="ok" style="font-weight:600;margin-bottom:6px">NCBI ${action.toUpperCase()}（限病毒）· ${hs.length} hits</div>` +
    `<p class="hint" style="margin:2px 0 8px">Best E-value <b>${bestE === Infinity ? '-' : bestE.toExponential(1)}</b> · Best identity <b>${bestI}%</b></p>` +
    `<table style="${tblCss}"><thead><tr>
      <th style="${thCss}">#</th><th style="${thCss}">Accession</th><th style="${thCss}">Description</th>
      <th style="${thCss}">Organism</th><th style="${thCss}">Identity</th><th style="${thCss}">Align Len</th>
      <th style="${thCss}">E-value</th><th style="${thCss}">Bit Score</th></tr></thead><tbody>` +
    hs.slice(0, 50).map((h, i) => {
      const idv = parseFloat(h.identity) || 0;
      const idvBg = idv >= 90 ? '#c8e6c9' : idv >= 60 ? '#fff9c4' : idv >= 40 ? '#ffe0b2' : '#ffcdd2';
      return `<tr ${trHover}>
        <td style="${tdCss}">${i + 1}</td>
        <td style="${tdCss}"><a href="${link(h.accession)}" target="_blank" rel="noopener" style="color:#1a5276;font-family:monospace">${esc(h.accession)}</a></td>
        <td style="${tdCss};white-space:normal;max-width:360px" title="${esc(h.title)}">${esc((h.title || '').slice(0, 110))}</td>
        <td style="${tdCss}"><i>${esc(h.sciname || '-')}</i></td>
        <td style="${tdCss};text-align:center"><span style="background:${idvBg};border-radius:3px;padding:1px 6px;font-weight:600">${esc(h.identity)}%</span></td>
        <td style="${tdCss};text-align:right">${esc(h.align_len)}</td>
        <td style="${tdCss};font-family:monospace">${esc(h.evalue)}</td>
        <td style="${tdCss};font-family:monospace;text-align:right">${esc(h.bit_score)}</td></tr>`;
    }).join('') + '</tbody></table>';
}

