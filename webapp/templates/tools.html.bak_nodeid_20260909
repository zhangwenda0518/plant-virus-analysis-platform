const CA_ACTIONS = { cdd: ['cdd'], hom: ['blastn', 'blastx'] };

async function loadCaRuns(scope, auto) {
  const sc = ANA_SCOPES[scope];
  try {
    const r = await fetch('/api/tool/runs');
    const runs = runsWithResult((await r.json()).filter(x => x.name.startsWith('contigs_')));
    const sel = $(sc.run);
    if (!sel) return;
    const cur = sel.value;
    sel.innerHTML = runs.length
      ? runs.map(x => `<option value="${esc(x.name)}">${esc(x.name)}</option>`).join('')
      : '<option value="">（先运行工具④得到 contigs_ 运行）</option>';
    if (auto && runs.length) sel.value = runs[0].name;
    else if (cur && runs.some(x => x.name === cur)) sel.value = cur;
    if (sel.value) loadCaContigs(scope);
  } catch (e) { /* 忽略 */ }
}

const caRows = {};              // scope -> rows
async function loadCaContigs(scope) {
  const sc = ANA_SCOPES[scope];
  const run = sc.run === 'anaRun' ? anaCurRun : val(sc.run);
  const box = $(sc.run.replace(/Run$/, 'Table'));
  if (!box) return;
  if (!run) { box.innerHTML = '<p class="hint">暂无数据</p>'; return; }
  try {
    const r = await fetch('/api/tool/viral_contigs?run=' + encodeURIComponent(run));
    if (!r.ok) {
      box.innerHTML = '<p class="hint" style="color:#b91c1c">加载失败: '
        + esc((await r.json()).error || r.status) + '</p>';
      return;
    }
    caRows[scope] = await r.json();
    if (!Array.isArray(caRows[scope]) || !caRows[scope].length) {
      box.innerHTML = '<p class="hint">该运行无病毒 contig 记录</p>'; return;
    }
    renderCaTable(scope);
  } catch (e) { box.innerHTML = '<p class="hint" style="color:#b91c1c">无法连接: ' + esc(e) + '</p>'; }
}

function renderCaTable(scope) {
  const sc = ANA_SCOPES[scope];
  const box = $(sc.run.replace(/Run$/, 'Table'));
  const rows = caRows[scope] || [];
  box.innerHTML = '<table class="table" style="width:100%;border-collapse:collapse">' +
    '<tr><th>Contig</th><th>Genus</th><th>Species</th><th>Length</th><th>分析</th></tr>' +
    rows.map(x => {
      const short = (x.contig || '').length > 32 ? x.contig.slice(0, 30) + '…' : (x.contig || '');
      const nc = x.near_complete === true || x.near_complete === 'True';
      return `<tr${nc ? ' style="background:#e8f5e9"' : ''}>` +
        `<td style="font-family:monospace;font-size:11px" title="${esc(x.contig)}">${esc(short)}</td>` +
        `<td>${x.genus ? esc(x.genus) : '<span style="color:#ccc">-</span>'}</td>` +
        `<td>${x.species ? esc(x.species) : '<span style="color:#ccc">-</span>'}</td>` +
        `<td>${esc(x.length)}</td>` +
        `<td style="white-space:nowrap">${CA_ACTIONS[scope].map(a =>
          `<button class="btn small" style="margin:1px" onclick="runAnalyze('${a}','${esc(x.contig)}','${scope}')">${a.toUpperCase()}</button>`).join('')}</td></tr>`;
    }).join('') + '</table>' +
    `<p class="hint">共 ${rows.length} 条 · NCBI 在线分析（数分钟），结果可重复查看</p>`;
}

