}

async function runVariant(btn) {
  const mode = (document.querySelector('input[name="vr_mode"]:checked') || {}).value || 'upstream';
  const params = {
    stage: 'variant',
    reference: val('vr_ref') || undefined,
    variant_qual: +val('vr_qual'),
    min_freq: +val('vr_min_freq'),
    aa_label_cutoff: +val('vr_aa_cutoff'),
    max_aa_labels: +val('vr_max_labels'),
    all_variants: $('vr_all_variants').checked || undefined,
    no_variant_evo: !$('vr_evo').checked || undefined,
    no_snpgenie: !$('vr_snpgenie').checked || undefined,
  };
  if (mode === 'bam') {
    if (!val('vr_bam_dir')) { alert('请填 BAM 目录'); return; }
    params.bam_dir = val('vr_bam_dir');
  } else if (mode === 'vcf') {
    if (!val('vr_vcf')) { alert('请填 VCF 文件'); return; }
    params.input_vcf = val('vr_vcf');
  } else {
    // 与上游衔接：指定 run 则把该 run 的 bam 目录当输入；留空交给后端默认逻辑
    const up = val('vr_run');
    if (up) params.bam_dir = `tool_runs/${up}/kvsuite/bam`;
  }
  const threads = 4;
  try {
    const r = await fetch('/api/tool/run', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tool: 'kvsuite', threads, params })});
    if (!r.ok) { alert('启动失败: ' + ((await r.json()).error || '')); return; }
    const d = await r.json();
    taskLogOpen.add(d.task);
    startPolling();
    watchTaskBtn(d.task, btn, '⏳ 变异分析中…', () => loadVariantResult(d.run));
  } catch (e) { alert('无法连接平台服务: ' + e); }
}

async function loadVariantResult(run) {
  if (!run) return;
  try {
    const r = await fetch('/api/tool/kvsuite_result?run=' + encodeURIComponent(run));
    if (!r.ok) return;
    const d = await r.json();
    $('vrResult').style.display = 'block';
    $('vrTitle').textContent = '病毒变异分析结果 · ' + run;
    renderVariant(d);
  } catch (e) { /* 忽略 */ }
}

function renderVariant(d) {
  const s = d.summary || {};
  const vsum = s.variant || {};
  const bits = [
    `${vsum.n_success || 0} 条参考成功`,
    `变异位点 ${s.n_variants || 0}`,
    `变异图 ${(d.variant_plots || []).length}`,
    `演化图 ${(d.evo_plots || []).length}`,
  ];
  if (s.n_snpgenie) bits.push(`SNPGenie ${s.n_snpgenie} 条`);
  if (vsum.n_skipped) bits.push(`跳过注释 ${vsum.n_skipped}`);
  $('vrSummary').innerHTML = bits.map(t =>
    `<span style="padding:2px 10px;border-radius:10px;background:#e3f2fd;font-size:11px;margin-right:6px">${esc(t)}</span>`).join('');

  const vCols = [['参考', 'accession'], ['位点', 'n_variants'],
    ['编码区注释', 'n_coding_ann']];
  $('vrAnnTable').innerHTML = kvTable(vsum.results, vCols, '无变异注释结果')
    + (vsum.skipped && vsum.skipped.length
      ? '<p class="hint" style="margin-top:8px">跳过：'
        + vsum.skipped.map(x => `${esc(x.genome)}（${esc(x.reason)}）`).join('；') + '</p>'
      : '');

  const run = d.run || '';
  const url = f => `/tool_runs/${encodeURIComponent(run)}/kvsuite/variant_plots/${encodeURIComponent(f)}`;

  // 基础四图（不带 _evo_）
  const base = (d.variant_plots || []).filter(f => !/_evo_/.test(f) && /\.png$/i.test(f));
  $('vrPlots').innerHTML = base.length
    ? base.map(f => `<div style="margin-bottom:14px">
        <div class="mono" style="font-size:11px;margin-bottom:4px">${esc(f)}</div>
        <img src="${url(f)}" style="width:100%;max-width:900px;border:1px solid #e0e0e0;border-radius:4px;background:#fff;cursor:zoom-in"
             onclick="window.open('${url(f)}','_blank')">
        <div style="margin-top:4px"><a class="mono" style="font-size:10.5px" href="${url(f.replace(/\.png$/i, '.pdf'))}" target="_blank">下载 PDF</a></div>
      </div>`).join('')
    : '<p class="hint">无基础变异图</p>';

  const man = d.evo_manifest || {};
  const ebits = [`${man.n_accessions || 0} 条参考`, `${(d.evo_plots || []).length} 张图`];
  const snps = (man.snpgenie || []).length;
  if (snps) ebits.push(`SNPGenie ${snps} 条`);
  if ((man.skipped || []).length) ebits.push(`跳过 ${man.skipped.length}`);
  $('vrEvoSummary').innerHTML = ebits.map(t =>
    `<span style="padding:2px 10px;border-radius:10px;background:#e8f5e9;font-size:11px;margin-right:6px">${esc(t)}</span>`).join('');

  const MODS = [
    ['spectrum', 'A', '分子突变谱（Ts/Tv · AFS · 等位频率分布）'],
    ['landscape', 'A', '突变景观（位点平均等位频率）'],
    ['density', 'B', '变异密度与基因组分布（KDE + 滑窗 + 基因轨道）'],
    ['popgen', 'C', "群体遗传学（πN/πS · 滑窗 π · Tajima's D）"],
    ['snpgenie', 'D', 'SNPGenie 位点/密码子层变异（变异类别分布 · N/S 密码子差异）']
  ];
  const byAcc = {};
  (d.evo_plots || []).forEach(f => {
    const m = f.match(/^(.+?)_evo_(spectrum|landscape|density|popgen|snpgenie)\.png$/i);
    if (!m) return;
    (byAcc[m[1]] = byAcc[m[1]] || {})[m[2].toLowerCase()] = f;
  });
  const accs = Object.keys(byAcc).sort();
  const out = [];
  MODS.forEach(([mod, tag, title]) => {
    const hits = accs.filter(a => byAcc[a][mod]);
    if (!hits.length) return;
    out.push(`<div style="margin:6px 0 18px">
      <div style="font-size:12px;font-weight:600;margin-bottom:6px">模块 ${esc(tag)} · ${esc(title)}</div>`);
    hits.forEach(a => {
      const f = byAcc[a][mod];
      out.push(`<div style="margin-bottom:14px">
        <div class="mono" style="font-size:11px;margin-bottom:4px">${esc(a)}</div>
        <img src="${url(f)}" style="width:100%;max-width:900px;border:1px solid #e0e0e0;border-radius:4px;background:#fff;cursor:zoom-in"
             onclick="window.open('${url(f)}','_blank')">
        <div style="margin-top:4px"><a class="mono" style="font-size:10.5px" href="${url(f.replace(/\.png$/i, '.pdf'))}" target="_blank">下载 PDF</a></div>
      </div>`);
    });
    out.push('</div>');
  });
  if (Object.keys(man).length) {
    const rows = [];
    (man.snpgenie || []).forEach(x => rows.push({ acc: x.accession || x.genome || '',
      product: 'SNPGenie', path: x.dir || x.path || '' }));
    (man.skipped || []).forEach(x => rows.push({ acc: x.accession || x.genome || '',
      product: '跳过', path: x.reason || '' }));
    if (rows.length) out.push(kvTable(rows,
      [['参考', 'acc'], ['产物', 'product'], ['路径 / 原因', 'path']], ''));
  }
  $('vrEvoPlots').innerHTML = out.length ? out.join('')
    : '<p class="hint">无扩展变异图（可能未开启，或该样本变异数不足）</p>';
  $('vrEvoTables').innerHTML = '';
}

