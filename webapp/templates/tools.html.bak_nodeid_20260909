function renderVerifyTable(d) {
  const rows = d.rows || [];
  const calls = d.summary?.calls || {};
  // 判定分档（对齐参考项目「已知 vs 新病毒」双阈值分档）
  const CALL_META = {
    known:   { label: '已知病毒', color: '#c8e6c9', bg: '#e8f5e9' },
    novel:   { label: '新病毒候选', color: '#b3e5fc', bg: '#e1f5fe' },
    domain_only: { label: '仅域证据', color: '#b9fbc0', bg: '#e0f7fa' },
    viroid:  { label: '类病毒', color: '#b3e5fc', bg: '#e1f5fe' },
    unclassified: { label: '未分类', color: '#ffe0b2', bg: '#fff3e0' },
  };
  const metaOf = k => CALL_META[k] || { label: k, color: '#e5e7eb', bg: '#fafafa' };
  const badges = Object.entries(calls).map(([k, v]) => {
    const m = metaOf(k);
    return `<span style="padding:2px 10px;border-radius:10px;background:${m.color};font-size:11px;margin-right:6px">${esc(m.label)} ${v}</span>`;
  }).join('');
  if (!rows.length) {
    return `<p class="hint">无记录</p>`;
  }
  const body = rows.map(r => {
    const c = r.call;
    const m = metaOf(c);
    const lin = [r.family, r.genus, r.species].filter(Boolean).join(' · ') || '—';
    const blastx = r.blastx_target
      ? `${esc(r.blastx_target)} <span class="hint">(${r.blastx_pident}% · cov ${r.blastx_scov || '—'}% · e=${esc(r.blastx_evalue)} · ${r.blastx_nhits}hit)</span>` : '—';
    const cdd = r.cdd_domains
      ? `${esc(r.cdd_domains)} <span class="hint">(tier ${esc(r.cdd_tier || '?')} · e=${esc(r.cdd_best_evalue)} · ${r.cdd_nhits}hit)</span>${r.cdd_descriptions ? `<br><span class="hint" style="font-size:11px">${esc(r.cdd_descriptions)}</span>` : ''}` : '—';
    const viroid = r.viroid_target
      ? `${esc(r.viroid_target)} <span class="hint">(${r.viroid_pident}% · cov ${r.viroid_cov}% · e=${esc(r.viroid_evalue)})</span>` : '—';
    return `<tr style="background:${m.bg}">
      <td class="mono">${esc(r.contig)}</td>
      <td>${esc(r.branch)}</td>
      <td><b>${esc(m.label)}</b></td>
      <td class="num">${r.len}</td>
      <td>${esc(r.host_source || '—')}</td>
      <td>${esc(lin)}</td>
      <td>${blastx}</td>
      <td>${cdd}</td>
      <td>${viroid}</td>
    </tr>`;
  }).join('');
  // 桑基 / 旭日：按验证结果 contig 的谱系重建层级，沿用分类报告原绘制方法
  // （realm→…→species 层级，而非自定义「宿主→判定」）。
  const rpt = buildVerifyReport(rows);
  drawSankey(rpt, 'vfSankey');
  drawSunburst(rpt, 'vfSun');
  return `<div style="margin-bottom:8px">${badges}</div>
    <div style="overflow-x:auto">
    <table class="tb" style="font-size:12px;width:100%;min-width:1080px">
      <thead><tr><th>Contig</th><th>分支</th><th>判定</th><th class="num">长度</th>
      <th>宿主</th><th>分类谱系（科·属·种）</th>
      <th>blastx 命中</th><th>CDD 结构域</th><th>类病毒命中</th></tr></thead>
      <tbody>${body}</tbody></table>
    </div>`;
}

/* 由验证结果 contig 行重建 kreport 式层级（与 buildReportFromContigs 同构），
   供 drawSankey / drawSunburst 按原分类报告方法绘制。 */
function buildVerifyReport(rows) {
  const K = ['realm', 'kingdom', 'phylum', 'class', 'order', 'family', 'genus', 'species'];
  const pick = rows.filter(c => K.some(k => (c[k] || '').trim()));
  if (!pick.length) return [];
  const nodeMap = new Map();
  const keyOf = (rank, name) => rank + '::' + name;
  pick.forEach(c => {
    const chain = [];
    K.forEach(k => { const v = (c[k] || '').trim(); if (v) chain.push({ k, v }); });
    let parentKey = '', parentName = '';
    chain.forEach((seg, i) => {
      const key = keyOf(seg.k, seg.v);
      if (!nodeMap.has(key)) {
        nodeMap.set(key, { rank: seg.k, name: seg.v, count: 0, depth: i });
      }
      nodeMap.get(key).count += 1;
      parentKey = key; parentName = seg.v;
    });
  });
  const out = [];
  K.forEach(k => {
    const layer = Array.from(nodeMap.values()).filter(n => n.rank === k);
    if (!layer.length) return;
    const total = layer.reduce((s, n) => s + n.count, 0);
    layer.forEach(n => out.push({ rank: k, name: n.name, taxid: '', count: n.count,
      proportion: total ? (n.count / total * 100).toFixed(2) : 0, depth: n.depth }));
  });
  return out;
}

