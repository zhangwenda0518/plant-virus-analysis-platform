  $(tbodyId).innerHTML = rows.map(r => {
    const gray = r.rank === 'no rank';
    const bold = RPT_STD_RANKS.has(r.rank) ? 'font-weight:bold' : '';
    return '<tr>' +
      `<td style="color:${gray ? '#aaa' : '#1a5276'}">${esc(r.rank || '')}</td>` +
      `<td style="padding-left:${8 + (r.depth || 0) * 8}px;${bold}">${esc(r.name || '')}</td>` +
      `<td class="num" style="color:#888">${esc(r.taxid == null ? '' : String(r.taxid))}</td>` +
      `<td class="num">${r.proportion == null ? '' : r.proportion}</td>` +
      `<td class="num">${(r.count || 0).toLocaleString()}</td></tr>`;
