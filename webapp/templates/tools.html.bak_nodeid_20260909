async function loadDbHint() {
  /* 病毒库状态显示在需要病毒库的工具②④卡片参数区内，
     同时填充「病毒库（分类 / 提取）」下拉——库列表来自 /api/dbs 的
     virus_libs 动态探测（databases/ 下的 kunpeng 库，自备预构建即插即用）。 */
  const VDB_LIB_LABELS = {
    virus_db:    '植物病毒库（主库）',
    plant_db:    'Plant 病毒库（自备）',
    refvirus_db: 'RefSeq Viral 全病毒库',
    rvdb_db:     'RVDb 病毒库',
    k2viral_db:  'Kraken2 Viral 转换库',
  };
  const ORDER = ['virus_db', 'plant_db', 'refvirus_db', 'rvdb_db', 'k2viral_db'];
  try {
    const r = await fetch('/api/dbs');
    const d = await r.json();
    document.querySelectorAll('.db-status').forEach(el => {
      el.textContent = d.virus?.ready
        ? '✔ 病毒库就绪'
        : '⚠ 主病毒库未就绪（请先到「数据库构建」页构建病毒库）';
    });
    const libs = (d.virus_libs || []).slice().sort((a, b) => {
      const ia = ORDER.indexOf(a.name), ib = ORDER.indexOf(b.name);
      return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib) ||
             a.name.localeCompare(b.name);
    });
    document.querySelectorAll('.virus-db-select').forEach(sel => {
      const cur = sel.value;
      sel.innerHTML = libs.map(lib =>
        `<option value="${esc(lib.path)}">✔ ` +
        `${esc(VDB_LIB_LABELS[lib.name] || lib.name)}</option>`).join('');
      if (![...sel.options].some(o => o.value === cur) && sel.options[0]) {
        sel.value = sel.options[0].value;
      }
    });
  } catch (e) { /* 忽略 */ }
}

