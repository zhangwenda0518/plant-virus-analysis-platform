/* Plotly 旭日图（宿主筛选动态用；绕过 taxburst iframe） */
function drawSunburst(rows, divId) {
  divId = divId || 'sunC';
  const ids = [], lab = [], par = [], val = [], stack = [];
  rows.forEach(function(r) {
    while (stack.length && stack[stack.length - 1].d >= r.depth) stack.pop();
    ids.push('n' + ids.length);
    lab.push(r.name.length > 26 ? r.name.slice(0, 24) + '..' : r.name);
    par.push(stack.length ? stack[stack.length - 1].id : '');
    val.push(r.count || 0);
    stack.push({ d: r.depth, id: 'n' + (ids.length - 1) });
  });
  if (!ids.length) { $(divId).innerHTML = '<div style="color:#999;padding:20px">无数据</div>'; return; }
  Plotly.newPlot(divId, [{ type: 'sunburst', ids: ids, labels: lab,
    parents: par, values: val, branchvalues: 'remainder', maxdepth: 6 }],
    { margin: { l: 10, r: 10, t: 10, b: 10 } }, { responsive: true });
}

