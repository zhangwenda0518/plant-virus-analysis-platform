async function linkOrf(btn) {
  if (!CUR) return;
  const run = val('orfRun');
  if (!run) { alert('先选择要关联的 orf/orfa 运行'); return; }
  const unlock = lockBtn(btn, '⏳ 关联中…');
  try {
    const d = await jfetch(`/api/submit/table/${encodeURIComponent(CUR)}/link_orf`, {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({run})});
    let msg = `已关联 ${d.run}：匹配 CDS ${d.n_cds} 条`;
    if (d.n_missing) msg += `，${d.n_missing} 个 contig 未匹配（${(d.missing || []).slice(0,3).join(', ')}${d.n_missing>3?'…':''}）`;
    const hosts = Object.entries(d.host_sources || {}).slice(0,3)
      .map(([c, h]) => `${c}:${h}`).join('，');
    if (hosts) msg += `；宿主线索 ${hosts}`;
    toast('🔗 关联完成', msg, {ttl: 8000});
    $('tblHint').textContent = '已关联 ' + d.run + ' — 可点击下方"生成 featuretable.tbl"';
    await openTable(CUR);
  } catch (e) { alert(e.message); }
  unlock();
}

async function genTbl(btn) {
  if (!CUR) return;
  const unlock = lockBtn(btn, '⏳ 生成中…');
  try {
    const d = await jfetch(`/api/submit/table/${encodeURIComponent(CUR)}/tbl`, {
      method: 'POST'});
    toast('🧬 特征表已生成', `${d.contigs.length} 个 contig · ${d.cds_total} 条 CDS` +
      (d.no_product ? `（${d.no_product} 条无 product→hypothetical）` : ''),
      {ttl: 6000});
    const pre = $('tblOut');
    pre.style.display = 'block';
    pre.textContent =
      `>Feature ×${d.contigs.length}（CDS 共 ${d.cds_total}）\n` +
      (d.skipped && d.skipped.length ? `⚠ 表内未匹配 contig（无 CDS）：${d.skipped.join(', ')}\n` : '') +
      (d.sources && d.sources.gff ? `坐标来源: ${d.sources.gff}\n` : '');
    await openTable(CUR);
    const sel = $('fileSel');
    if ([...sel.options].some(o => o.value === 'featuretable.tbl')) { sel.value = 'featuretable.tbl'; showFile(); }
  } catch (e) { alert(e.message); }
  unlock();
}

async function autoFasta(btn) {
  if (!CUR) return;
  const unlock = lockBtn(btn, '⏳ 推断中…');
