}

async function doValidate() {
  if (!CUR) return;
  const d = await jfetch(`/api/submit/table/${encodeURIComponent(CUR)}/validate`);
  const box = $('valOut');
  box.style.display = '';
  if (!d.issues.length) { box.textContent = t('sb.validateOk', '✓ 可以提交'); return; }
  const KIND = { missing_col: '缺少列', placeholder: '必填未填',
                 format: '格式问题', duplicate: '重复' };
  box.textContent = `${d.issues.length} ${t('sb.issues', '个问题：')}\n` +
    d.issues.map(i => i.kind === 'missing_col'
      ? `  [缺少列] ${i.column} — ${i.desc}`
      : `  [${KIND[i.kind] || i.kind} × ${i.count}] ${i.column} — ${i.desc}` +
        (i.examples?.length ? `\n      例: ${i.examples.map(x => JSON.stringify(x)).join(', ')}` : '')
    ).join('\n');
}

async function doFasta(btn) {
  if (!CUR) return;
  const src = val('fastaSrc');
  if (!src) { alert('请先填平台内 FASTA 路径'); return; }
  const unlock = lockBtn(btn, '⏳ 提取中…');
  try {
    const d = await jfetch(`/api/submit/table/${encodeURIComponent(CUR)}/fasta`, {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({fasta: src})});
    const lines = [`✓ sequences.fsa 已生成：${d.written} 条序列`];
    if (d.missing.length) lines.push(`⚠ 表内有而 FASTA 缺 ${d.missing.length} 条（这些序列不会出现在提交里）：${d.missing.slice(0, 5).join(', ')}${d.missing.length > 5 ? ' …' : ''}`);
    if (d.extra.length) lines.push(`ℹ FASTA 有而表内没有 ${d.extra.length} 条（未导出）`);
    if (d.short.length) lines.push(`⚠ 短于 200nt ${d.short.length} 条（NCBI GenBank 一般拒收）：${d.short.map(x => `${x.id}(${x.length}bp)`).slice(0, 5).join(', ')}`);
    if (d.duplicates.length) lines.push(`⚠ sequence_name 重复：${d.duplicates.slice(0, 5).join(', ')}`);
    if (d.replaced) lines.push(`ℹ ${d.replaced} 个非 IUPAC 字符已替换为 N`);
    const box = $('fastaOut');
    box.textContent = lines.join('\n');
    box.style.display = '';
    await openTable(CUR);
    const sel = $('fileSel');
    if ([...sel.options].some(o => o.value === 'sequences.fsa')) { sel.value = 'sequences.fsa'; showFile(); }
  } catch (e) { alert(e.message); }
  unlock();
}

async function doPackage(btn) {
  if (!CUR) return;
  const unlock = lockBtn(btn, '⏳ 打包中…');
  try {
    const d = await jfetch(`/api/submit/table/${encodeURIComponent(CUR)}/package`, {method: 'POST'});
    toast('📦 打包完成', `${d.files} 个文件`, {ttl: 5000});
    location.href = d.download;
  } catch (e) { alert(e.message); }
  unlock();
}

async function doTaxCheck(btn) {
  if (!CUR) return;
  const unlock = lockBtn(btn, '⏳ 查询 NCBI…');
  try {
    const d = await jfetch(`/api/submit/table/${encodeURIComponent(CUR)}/taxonomy_check`, {method: 'POST'});
    const box = $('valOut');
    box.style.display = '';
    if (!d.rows.length) { box.textContent = '（表内没有可校验的 organism）'; }
    else {
      const lines = d.rows.map(r =>
        `  ${r.found ? '✓' : '✗ 未收录'} ${r.organism}${r.taxid ? ' (taxid ' + r.taxid + ')' : ''}`);
      box.textContent = `NCBI Taxonomy 物种名校验（${d.rows.length} 个）：\n` + lines.join('\n') +
        (d.missing.length ? `\n\n⚠ ${d.missing.length} 个物种名未被 NCBI 收录，直接提交会被拒：\n` +
         `   新物种需先与 NCBI 沟通（taxonomy@ncbi.nlm.nih.gov）或改用更高级阶元名。` : '');
    }
  } catch (e) { alert(e.message); }
  unlock();
}

async function loadContigRuns() {
