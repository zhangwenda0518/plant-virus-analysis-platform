}

function downloadUrl(fname) {
  return `/submissions/${encodeURIComponent(CUR)}/${encodeURIComponent(fname)}`;
}
async function downloadBs() {
  if (!CUR) return;
  try {
    const d = await jfetch(`/api/submit/table/${encodeURIComponent(CUR)}/biosample`, {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({include_placeholders: $('bsIncPh') && $('bsIncPh').checked})});
    toast(t('sb.bsTsv', 'BioSample TSV'), `${d.rows} rows (${d.skipped} skipped)`, {ttl: 6000});
    location.href = downloadUrl('biosample_registration.tsv');
  } catch (e) { alert(e.message); }
}
function downloadXlsx() {
  if (!CUR) return;
  location.href = downloadUrl('unified_metadata.xlsx');
}
async function genSbt() {
  if (!CUR) return;
  const F = k => val('sbt' + k);
  try {
    const d = await jfetch(`/api/submit/table/${encodeURIComponent(CUR)}/sbt`, {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({fields: {
          last: F('Last'), first: F('First'), middle: F('Middle'),
          affil: F('Affil'), div: F('Div'), city: F('City'), sub: F('Sub'),
          country: F('Country'), street: F('Street'), email: F('Email'),
          postal: F('Postal')},
        title: F('Title'),
        extra_authors: val('sbtExtra').split(/\r?\n/).filter(Boolean)})});
    toast(t('sb.sbtOk', 'template.sbt 已生成'), `${d.authors} authors`, {ttl: 6000});
    await openTable(CUR);
    const sel = $('fileSel');
    if ([...sel.options].some(o => o.value === 'template.sbt')) { sel.value = 'template.sbt'; showFile(); }
  } catch (e) { alert(e.message); }
}

async function genSqn(btn) {
  if (!CUR) return;
  const F = k => val('sbt' + k);
  const unlock = lockBtn(btn, '⏳ 生成 .sqn 中（含 suvtk BFVD 注释，可能需数十秒）…');
  const pre = $('sqnOut');
  pre.style.display = 'block';
  pre.textContent = '正在运行 suvtk 提交链…（features → comments → table2asn）';
  try {
    const author = {
      last: F('Last'), first: F('First'), middle: F('Middle'),
      affil: F('Affil'), div: F('Div'), city: F('City'), sub: F('Sub'),
      country: F('Country'), street: F('Street'), email: F('Email'),
      postal: F('Postal')};
    const d = await jfetch(`/api/submit/table/${encodeURIComponent(CUR)}/sqn`, {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({author, use_features: !$('sqnUseOwn').checked})});
    const st = d.stats || {};
    pre.textContent =
      `✅ .sqn 生成完成\n` +
      `文件: ${d.sqn}\n` +
      `校验: Error ${st.error} / Warning ${st.warning} / Info ${st.info}\n\n` +
      `—— 校验摘要（前若干条）——\n` +
      (d.val_head && d.val_head.length ? d.val_head.join('\n') : '(无)');
    toast('📦 .sqn 已生成', `Error ${st.error} · Warning ${st.warning}`, {ttl: 8000});
    await openTable(CUR);
  } catch (e) {
    pre.textContent = '❌ 生成失败：' + e.message;
    alert(e.message);
  }
  unlock();
}

function sqnUseOwnChange() {
  const own = $('sqnUseOwn').checked;
  const h = $('sqnHint');
  h.textContent = own ? '将使用上方生成的 featuretable.tbl（平台自家注释）'
                      : '将运行 suvtk features（BFVD 功能注释）';
}

/* ── ④ 文件预览 ── */
function renderFiles(files) {
  const sel = $('fileSel');
  const cur = sel.value;
  sel.innerHTML = '<option value="">—</option>' +
    files.filter(f => !f.endsWith('/') && f !== 'unified_metadata.csv' && !f.startsWith('source_individual'))
      .map(f => `<option value="${esc(f)}">${esc(f)}</option>`).join('');
  if (cur && files.includes(cur)) sel.value = cur;
  $('fileDl').style.visibility = sel.value ? 'visible' : 'hidden';
}
async function showFile() {
  const f = val('fileSel');
  $('fileDl').style.visibility = f ? 'visible' : 'hidden';
  exitFileEdit();
  if (f) $('fileDl').href = downloadUrl(f);
  if (!f) { $('fileView').textContent = ''; return; }
  try {
    const d = await jfetch(`/api/submit/table/${encodeURIComponent(CUR)}/file?name=${encodeURIComponent(f)}`);
    $('fileView').textContent = d.content || '(empty)';
  } catch (e) { $('fileView').textContent = 'Error: ' + e.message; }
}

/* 预览在线编辑（原 GUI Preview 标签 Edit/Save；.sqn 二进制锁定） */
function toggleFileEdit(btn) {
  const f = val('fileSel');
  if (!f) return;
  if ($('fileView').isContentEditable) { exitFileEdit(); return; }
  if (f.toLowerCase().endsWith('.sqn')) {
    alert('.sqn 为二进制 ASN.1，仅可查看（同原 GUI）');
    return;
  }
  $('fileView').contentEditable = 'true';
  $('fileView').focus();
  btn.textContent = '🔒 锁定';
  $('fileSaveBtn').style.display = '';
}
function exitFileEdit() {
  $('fileView').contentEditable = 'false';
  const btn = $('fileEditBtn');
  if (btn) btn.textContent = '✏️ 编辑';
  $('fileSaveBtn').style.display = 'none';
}
async function saveFileEdit() {
  const f = val('fileSel');
  if (!f || !CUR) return;
  try {
    await jfetch(`/api/submit/table/${encodeURIComponent(CUR)}/file_save`, {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({name: f, content: $('fileView').textContent})});
    toast('已保存', f, {ttl: 4000});
    exitFileEdit();
  } catch (e) { alert(e.message); }
}

renderQuickFill();
loadContigRuns();
loadOrfRuns();
// 默认展开提交工作区：自动打开最近项目（无则第一个），让 ②③④ 直接可见
(async function autoOpen() {
  try {
    const list = await jfetch('/api/submit/tables');
    if (list && list.length) {
      let last = null;
      try { last = localStorage.getItem('vp_submit_last'); } catch (e) {}
      const t = list.find(p => p.name === last) || list[0];
      await openTable(t.name);
    } else {
      refreshProjects();
    }
  } catch (e) { refreshProjects(); }
})();

