async function loadOrfRuns() {
  const sel = $('orfRun');
  if (!sel) return;
  try {
    const runs = await jfetch('/api/submit/orf_runs');
    sel.innerHTML = runs.length
      ? runs.map(r => `<option value="${esc(r)}">${esc(r)}</option>`).join('')
      : '<option value="">（暂无 orf/orfa 注释运行）</option>';
  } catch (e) { sel.innerHTML = '<option value="">（加载失败）</option>'; }
