    }
  } catch (e) { alert(e.message); }
  unlock();
}

async function importRun(btn) {
  if (!CUR) return;
  const run = val('impRun');
  if (!run) { alert('先选择要导入的运行'); return; }
  const unlock = lockBtn(btn, '⏳ 导入中…');
  try {
    const d = await jfetch(`/api/submit/table/${encodeURIComponent(CUR)}/import_run`, {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({run})});
    toast('📥 导入完成', `新增 ${d.added} 行，跳过 ${d.skipped}`, {ttl: 6000});
