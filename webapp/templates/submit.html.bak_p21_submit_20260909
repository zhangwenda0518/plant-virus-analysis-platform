  if (!sel) return;
  try {
    const runs = await jfetch('/api/submit/contig_runs');
    sel.innerHTML = runs.length
      ? runs.map(r => `<option value="${esc(r)}">${esc(r)}</option>`).join('')
      : '<option value="">（暂无含分类表的 contigs 运行）</option>';
