<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>宿主去除与序列提取 - 植物病毒分析平台</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="vp-lang" content="{{ lang }}">
<script>try{if(localStorage.getItem("vp_theme")==="dark")document.documentElement.setAttribute("data-theme","dark")}catch(e){}</script>
<link rel="stylesheet" href="/static/app.css?v={{ asset_v }}">
</head>
<body>
{% include "_nav.html" %}

<div class="page">
  <div class="tools-layout group-layout">
    {% include "_group_nav.html" %}
    <main class="group-main">
  <div class="layout">
    <div class="col">
      <div class="card">
        <h1>🧹 宿主去除与序列提取</h1>
        <p class="hint">独立模块：kunpeng 宿主库分类 reads → 剔除宿主 read 对 →
        提取保留非宿主序列（kept FASTQ）。不需要创建样品，选文件直接运行；
        前置条件：宿主库已构建（首页 →「数据资源 → 数据库构建」）。</p>
        <div id="hostStat" class="dbbadge"></div>

        <label>输入类型</label>
        <select id="hr_type" onchange="hrRows()">
          <option value="pe">双端 FASTQ（R1 + R2）</option>
          <option value="single">单端 FASTQ</option>
        </select>

        <label>R1 FASTQ（必选，支持 .gz）</label>
        <div class="filerow">
          <input id="hr_r1" type="text" placeholder="选择平台目录内的 .fastq[.gz]">
          <button class="btn small" onclick="browse('hr_r1')">📁</button>
          <button class="btn small" onclick="pasteSeq('hr_r1', '.fastq')" title="粘贴 FASTQ">📋</button>
        </div>
        <div id="row_hr_r2">
          <label>R2 FASTQ（双端时必选）</label>
          <div class="filerow">
            <input id="hr_r2" type="text" placeholder="选择 R2 .fastq[.gz]">
            <button class="btn small" onclick="browse('hr_r2')">📁</button>
          <button class="btn small" onclick="pasteSeq('hr_r2', '.fastq')" title="粘贴 FASTQ">📋</button>
          </div>
        </div>

        <div style="display:flex;gap:16px;flex-wrap:wrap">
          <div class="gp-item">
            <label>分类置信度（0~1，越大越严格）</label>
            <input id="hr_conf" type="number" step="0.05" value="0" min="0" max="1"
                   title="kunpeng -T：分值≥阈值的 read 才判为宿主。0=最灵敏；0.05~0.2 常规">
          </div>
          <div class="gp-item">
            <label>线程数（留空=自动）</label>
            <input id="hr_threads" type="number" min="1" placeholder="自动">
          </div>
        </div>

        <label>宿主库目录（留空 = 使用平台已构建宿主库）</label>
        <div class="filerow">
          <input id="hr_db" type="text" placeholder="默认：数据库构建页构建的宿主库">
          <button class="btn small" onclick="browseDir('hr_db')">📂</button>
        </div>

        <div style="margin-top:12px">
          <button class="btn primary" onclick="runHostRemoval(this)">▶ 运行宿主去除</button>
        </div>

        <div class="tool-out">
          <div class="tool-out-head">📤 输出</div>
          <div class="toolrun" id="toolrun-hostremoval"></div>
        </div>
        <p class="hint">产物：kept_R1/R2.fastq.gz（非宿主 reads，即下一步病毒识别的输入）、
        kreport 分类报告、stats.json 统计（总对数 / 保留 / 剔除 / 宿主占比）。</p>
      <div class="rh" id="rh-hostremoval"></div>
      </div>
    </div>
  </div>
    </main>
  </div>
</div>

<!-- 文件/目录选择对话框（与其它页共用 app.js 逻辑） -->
<div id="dlgMask" class="dlgmask" style="display:none">
  <div class="dlg">
    <div class="dlghead"><b data-i18n="c.chooseFile">选择文件</b>
      <button class="btn small" onclick="closeDlg()">✕</button></div>
    <div id="dlgPath" class="dlgpath"></div>
    <div id="dlgList" class="dlglist"></div>
    <div id="dlgPickDir" style="display:none;padding:10px 16px;border-top:1px solid var(--line-100);text-align:right">
      <button class="btn small primary" onclick="pickDir()" data-i18n="c.pickDir">选择此目录 ✔</button>
    </div>
  </div>
</div>

<script src="/static/i18n.js?v={{ asset_v }}"></script>
<script src="/static/app.js?v={{ asset_v }}"></script>
<script>
/* $ / esc / browse / browseDir / loadDbs / startPolling / taskLogOpen 均来自 app.js */

function hrRows() {
  $('row_hr_r2').style.display = $('hr_type').value === 'pe' ? '' : 'none';
}

function val(id) { return ($(id)?.value || '').trim(); }

async function runHostRemoval(btn) {
  const pe = $('hr_type').value === 'pe';
  if (!val('hr_r1')) { alert('请选择 R1 FASTQ'); return; }
  if (pe && !val('hr_r2')) { alert('双端输入需同时选择 R2 FASTQ'); return; }
  const params = { r1: val('hr_r1'), r2: pe ? val('hr_r2') : '',
                   confidence: +val('hr_conf') || 0, db: val('hr_db') };
  try {
    const r = await fetch('/api/tool/run', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tool: 'hostremoval',
                             threads: +val('hr_threads') || null, params })});
    if (!r.ok) { alert('启动失败: ' + ((await r.json()).error || '')); return; }
    const d = await r.json();
    taskLogOpen.add(d.task);
    startPolling();
    $('tasks')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    watchTaskBtn(d.task, btn, '⏳ 运行中…');
  } catch (e) { alert('无法连接平台服务: ' + e); }
}

hrRows();
loadDbs();
startPolling();

// 下载页「🚫 去宿主」发送过来的文件预填
(function () {
  const pf = takePrefill('hostremoval');
  if (!pf) return;
  if (pf.r2) { $('hr_type').value = 'pe'; } else { $('hr_type').value = 'single'; }
  hrRows();
  $('hr_r1').value = pf.r1 || '';
  $('hr_r2').value = pf.r2 || '';
  toast('已带入下载文件', (pf.r1 || '') + (pf.r2 ? ' + ' + pf.r2 : ''), { ttl: 5000 });
})();
</script>
</body>
</html>
