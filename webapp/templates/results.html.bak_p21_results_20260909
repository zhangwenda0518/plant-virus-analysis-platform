<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
<title>分析结果 - 植物病毒分析平台</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="vp-lang" content="{{ lang }}">
<script>try{if(localStorage.getItem("vp_theme")==="dark")document.documentElement.setAttribute("data-theme","dark")}catch(e){}</script>
<link rel="stylesheet" href="/static/app.css?v={{ asset_v }}">
</head>
<body>
{% include "_nav.html" %}

<div class="page">
  <!-- 分区导航：与其他二级页 group-topbar 同款（rsShow 切换，hash 深链兼容） -->
  <nav class="group-topbar">
    <a class="gt-home" href="/results">🏠 结果中心</a>
    <div class="gt-items" id="rsPills">
      <a class="gt-item" data-sec="samples" href="#samples">📋 样品结果</a>
      <a class="gt-item" data-sec="meta" href="#meta">🔎 公共检索</a>
      <a class="gt-item" data-sec="runs" href="#runs">🧪 专项运行</a>
      <a class="gt-item" data-sec="sdt" href="#sdt">🧬 SDT 分析</a>
      <a class="gt-item" data-sec="msa" href="#msa">🧬 MSA 查看</a>
      <a class="gt-item" data-sec="tree" href="#tree">🌳 进化树</a>
      <a class="gt-item" data-sec="seqview" href="#seqview">📄 序列查看器</a>
    </div>
  </nav>

  <div class="rs-sec" id="sec-samples">
  <div class="card">
    <h2><span data-i18n="rs.title">已分析样品</span>
      <button class="btn small" onclick="location.reload()" data-i18n="c.refresh">刷新</button></h2>
    {% if not samples %}
    <p class="hint" data-i18n="rs.noResult">暂无结果。到「样品分析」页运行一个样品，或确认 results/ 目录。</p>
    {% endif %}
    <table class="tbl" id="sampleTbl">
      <tr><th>样品</th><th>最近运行</th><th>报告</th><th>操作</th></tr>
      {% for s in samples %}
      <tr>
        <td>{{ s.name }}</td>
        <td>{{ s.mtime }}</td>
        <td>{% if s.report %}<span class="ok">✔ 有</span>{% else %}<span class="no">—</span>{% endif %}</td>
        <td>
          {% if s.report %}
          <a class="btn small" target="_blank" href="/report/{{ s.name }}">📊 打开报告</a>
          {% endif %}
          <button class="btn small" onclick="openDir('{{ s.name }}')">📂 目录</button>
          <button class="btn small" onclick="toggleFiles('{{ s.name }}', this)">📁 文件</button>
          <button class="btn small" onclick="clearSample('{{ s.name }}', this)"
                  title="只清空分析产物，保留样品与输入信息">🧹 清除结果</button>
          <button class="btn small danger" onclick="deleteSample('{{ s.name }}', this)"
                  title="连同样品登记与全部文件一并删除">🗑 删除样品</button>
        </td>
      </tr>
      <tr class="filerow-tr" style="display:none">
        <td colspan="4"><div class="filelist" id="files_{{ s.name }}"></div></td>
      </tr>
      {% endfor %}
    </table>
    {% if archived %}
    <details style="margin-top:12px">
      <summary style="cursor:pointer;color:#64748b">📁 归档项目（{{ archived|length }} 个历史/测试样品，已收起）</summary>
      <table class="tbl" style="margin-top:8px">
        <tr><th>样品</th><th>最近运行</th><th>报告</th><th>操作</th></tr>
        {% for s in archived %}
        <tr>
          <td>{{ s.name }}</td>
          <td>{{ s.mtime }}</td>
          <td>{% if s.report %}<span class="ok">✔ 有</span>{% else %}<span class="no">—</span>{% endif %}</td>
          <td>
            {% if s.report %}
            <a class="btn small" target="_blank" href="/archive_report/{{ s.name }}">📊 打开报告</a>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </table>
      <p class="hint">归档样品不出现在各模块下拉与首页最近列表；如需恢复，把
      results/_archive/ 下的目录移回 results/ 即可。</p>
    </details>
    {% endif %}
  </div>

  <div class="card">
    <h2 data-i18n="hm.hubSection">📊 专项结果入口</h2>
    <p class="hint" data-i18n="hub.hint">共线性比较图与 LOGAN 溯源报告在此聚合，不必记住它们分别在哪个页面。</p>
    <div id="hubBox"><p class="hint" data-i18n="c.loading">加载中…</p></div>
  </div>
  </div>

  <div class="rs-sec" id="sec-meta" style="display:none">
  <div class="card">
    <h2>🔎 公共检索项目（SRA + GSA）
      <button class="btn small" onclick="mmLoad()" data-i18n="c.refresh">刷新</button></h2>
    <p class="hint">「公共数据检索」页每次检索自动归档为独立项目（双存储：检索结果 + Core14 元数据）。
       在此查看 / 预览 / 下载 / 删除，点「打开检索页」可继续编辑与 AI 补全。</p>
    <div id="mmBox"><p class="hint">加载中…</p></div>
  </div>
  </div>

  <div class="rs-sec" id="sec-runs" style="display:none">
  <div class="card" id="runs">
    <h2>🧪 专项分析运行（工具④分类 / 去宿主 / ORF / 图谱引物 / 质控…）</h2>
    <p class="hint">所有专项工具运行的记录与产物都保留在这里（30 条最近）。
       点击文件名下载；contig 分类运行可打开交互报告（桑基图 / 旭日图 / 分类表）。</p>
    <div id="runsBox"><p class="hint">加载中…</p></div>
  </div>
  </div>

  <div class="rs-sec" id="sec-sdt" style="display:none">
  <div class="card" id="sdt">
    <h2 data-i18n="rs.sdt">SDT 交互分析</h2>
    <p class="hint" data-i18n="rs.sdtHint">样品流程产物的 SDT 全长成对 identity 矩阵（05_phylo/&lt;组&gt;/sdt_matrix.csv），在线交互查看热图。</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:end">
      <div class="gp-item">
        <label data-i18n="rs.sample">样品</label>
        <select id="sdtSample" onchange="sdtLoadGroups()" style="min-width:180px">
          <option value="">（加载中…）</option>
        </select>
      </div>
      <div class="gp-item">
        <label data-i18n="rs.group">分组（05_phylo）</label>
        <select id="sdtGroup" onchange="sdtDraw()" style="min-width:220px">
          <option value="">（先选样品）</option>
        </select>
      </div>
      <button class="btn primary" onclick="sdtDraw()">📈 绘制 identity 热图</button>
    </div>
    <div class="hint" id="sdtMeta" style="margin-top:8px"></div>
    <div id="sdtHeat" style="margin-top:6px;width:100%;height:600px;display:none"></div>
  </div>
  </div>

  <div class="rs-sec" id="sec-msa" style="display:none">
  <div class="card" id="msa">
    <h2 data-i18n="rs.msa">MSA 查看（SNP-only 变异热图）</h2>
    <p class="hint" data-i18n="rs.msaDesc">选样品与分组，只显示比对中的<b>变异位点</b>（参考 PhyloSuite MSA
       Viewer 的 SNP-only 设计）：ACGT 彩色字符热图 + 共识行 + 每列变异度柱。
       大比对自动分页；优先显示建树用的清剪后比对（aln.trim）。</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:end">
      <div class="gp-item">
        <label data-i18n="rs.sample">样品</label>
        <select id="msaSample" onchange="msaLoadGroups()" style="min-width:180px">
          <option value="">（加载中…）</option>
        </select>
      </div>
      <div class="gp-item">
        <label data-i18n="rs.group">分组（05_phylo）</label>
        <select id="msaGroup" onchange="msaLoad()" style="min-width:220px">
          <option value="">（先选样品）</option>
        </select>
      </div>
      <div class="gp-item">
        <label data-i18n="rs.cols">每页列数</label>
        <select id="msaCols" onchange="msaRender()">
          <option>60</option><option selected>100</option><option>150</option>
        </select>
      </div>
      <label class="chk"><input type="checkbox" id="msaCons" checked onchange="msaRender()"> <span data-i18n="rs.cons">共识行</span></label>
      <label class="chk"><input type="checkbox" id="msaDiv" checked onchange="msaRender()"> <span data-i18n="rs.div">变异度柱</span></label>
    </div>
    <div id="msaNav" style="margin-top:10px;display:none">
      <button class="btn small" onclick="msaPage(-1)">◀ 上一页</button>
      <span class="hint" id="msaPageInfo"></span>
      <button class="btn small" onclick="msaPage(1)">下一页 ▶</button>
      <span class="hint" id="msaMeta" style="margin-left:12px"></span>
    </div>
    <div class="scroll-vh" id="msaBox" style="margin-top:10px">
      <p class="hint" data-i18n="c.noData">暂无数据</p>
    </div>
  </div>
  </div>

  <div class="rs-sec" id="sec-tree" style="display:none">
  <div class="card" id="tree">
    <h2 data-i18n="rs.tree">进化树查看（交互式）</h2>
    <p class="hint" data-i18n="rs.treeDesc">05_phylo/&lt;组&gt;/ 的建树结果（Archaeopteryx.js 渲染）：
       FastTree tree.nwk 或 IQ-TREE treefile/contree。矩形/环形/无根布局、支持值、缩放、搜索、
       PNG/SVG/PDF 导出等在查看器左上面板操作；自动识别内部节点支持值并默认显示。</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:end">
      <div class="gp-item">
        <label>样品</label>
        <select id="treeSample" onchange="treeLoadGroups()" style="min-width:180px">
          <option value="">（加载中…）</option>
        </select>
      </div>
      <div class="gp-item">
        <label data-i18n="rs.group">分组（05_phylo）</label>
        <select id="treeGroup" onchange="treeLoadFiles()" style="min-width:200px">
          <option value="">（先选样品）</option>
        </select>
      </div>
      <div class="gp-item">
        <label data-i18n="rs.treeFile">树文件</label>
        <select id="treeFile" onchange="treeLoad()" style="min-width:170px">
          <option value="">（先选分组）</option>
        </select>
      </div>
    </div>
    <div class="hint" id="treeMeta" style="margin-top:8px"></div>
    <div id="treeBox" style="margin-top:6px;height:72vh;overflow:hidden;background:#fff;border:1px solid #e2e8f0;border-radius:6px">
      <p class="hint" data-i18n="c.noData">暂无数据</p>
    </div>
  </div>
  </div>

  <div class="rs-sec" id="sec-seqview" style="display:none">
  <div class="card" id="t-seqview">
    <h2>📄 <span data-i18n="sv.title">序列查看器</span></h2>
    <p class="hint" data-i18n="sv.hint">选择或拖入 FASTA/FASTA.gz：流式统计序列数/总碱基，分页浏览 ID、长度、GC%、简并碱基比例与序列预览。</p>
    <div class="filerow">
      <input id="svPath" type="text" placeholder="点 📁 选择或拖入 FASTA 文件">
      <button class="btn small" onclick="browse('svPath')">📁</button>
      <button class="btn small primary" onclick="seqviewLoad(0)">🔍 查看</button>
    </div>
    <div class="hint" id="svMeta" style="margin:6px 0 0"></div>
    <div class="scroll-vh" id="svBox" style="margin-top:8px"><p class="hint" data-i18n="c.noData">暂无数据</p></div>
    <div class="pager" id="svPager" style="display:none">
      <button class="btn small" onclick="seqviewLoad(svPage-1)">◀ 上一页</button>
      <span class="hint" id="svPageInfo"></span>
      <button class="btn small" onclick="seqviewLoad(svPage+1)">下一页 ▶</button>
    </div>
  </div>
  </div>
</div>

<!-- Archaeopteryx.js 进化树查看器（d3 v7 + sax + phyloxml + forester，全部本地离线；
     jspdf/svg2pdf 提供 PDF 导出，canvg（ESM）提供 PNG 导出） -->
<script src="/static/vendor/archaeopteryx/d3.v7.min.js"></script>
<script src="/static/vendor/archaeopteryx/sax.js"></script>
<script src="/static/vendor/archaeopteryx/phyloxml.js"></script>
<script src="/static/vendor/archaeopteryx/forester.js"></script>
<script src="/static/vendor/archaeopteryx/jspdf.umd.min.js"></script>
<script src="/static/vendor/archaeopteryx/svg2pdf.umd.min.js"></script>
<script src="/static/vendor/archaeopteryx/archaeopteryx.js"></script>
<script type="module">
  import { Canvg } from '/static/vendor/archaeopteryx/canvg.js';
  window.Canvg = Canvg;
</script>
<script src="/static/plotly.min.js?v={{ asset_v }}"></script>
<script src="/static/i18n.js?v={{ asset_v }}"></script>
<script src="/static/app.js?v={{ asset_v }}"></script>
<script>
/* ---------------- 样品/集合列表：fetchSampleList/sampleLabel 由 app.js 提供 ---------------- */

/* ---------------- MSA SNP-only 查看器 ---------------- */
let msaData = null, msaPageNo = 0;

async function msaLoadSamples() {
  const sel = $('msaSample');
  try {
    const list = await fetchSampleList();
    sel.innerHTML = list.length
      ? list.map(x => `<option value="${esc(x.sample)}">${esc(sampleLabel(x))}</option>`).join('')
      : `<option value="">${t('rs.noAln')}</option>`;
    if (sel.value) msaLoadGroups();
  } catch (e) { sel.innerHTML = '<option value="">加载失败</option>'; }
}

async function msaLoadGroups() {
  const s = $('msaSample').value, sel = $('msaGroup');
  if (!s) { sel.innerHTML = `<option value="">${t('rs.noGroup')}</option>`; return; }
  try {
    const list = await fetchSampleList();
    const item = list.find(x => x.sample === s);
    sel.innerHTML = (item?.groups || []).map(g =>
      `<option value="${esc(g.group)}">${esc(g.group)}${g.aln === 'trim' ? '（清剪后）' : ''}</option>`).join('')
      || `<option value="">${t('rs.noGroup')}</option>`;
    if (sel.value) msaLoad();
  } catch (e) { sel.innerHTML = '<option value="">加载失败</option>'; }
}

async function msaLoad() {
  const s = $('msaSample').value, g = $('msaGroup').value;
  const box = $('msaBox');
  if (!s || !g) { box.innerHTML = `<p class="hint">${t('c.noData')}</p>`; $('msaNav').style.display = 'none'; return; }
  box.innerHTML = `<p class="hint">${t('c.loading')}</p>`;
  try {
    const r = await fetch(`/api/msa/data?sample=${encodeURIComponent(s)}&group=${encodeURIComponent(g)}`);
    if (!r.ok) { box.innerHTML = '<p class="hint" style="color:#b91c1c">' + esc((await r.json()).error || '加载失败') + '</p>'; return; }
    msaData = await r.json();
    msaPageNo = 0;
    msaRender();
  } catch (e) { box.innerHTML = '<p class="hint" style="color:#b91c1c">无法连接: ' + esc(e) + '</p>'; }
}

function msaPage(d) {
  const nChunks = Math.max(1, Math.ceil(msaData.n_snp / +$('msaCols').value));
  msaPageNo = Math.min(nChunks - 1, Math.max(0, msaPageNo + d));
  msaRender();
}

function msaRender() {
  const box = $('msaBox');
  if (!msaData) { box.innerHTML = `<p class="hint">${t('c.noData')}</p>`; return; }
  if (!msaData.n_snp) {
    box.innerHTML = '<p class="hint">比对内无变异位点（所有序列完全一致）</p>';
    $('msaNav').style.display = 'none';
    return;
  }
  const out = snpTableHtml(msaData, +$('msaCols').value, msaPageNo,
                           $('msaCons').checked, $('msaDiv').checked);
  box.innerHTML = out.html;
  $('msaNav').style.display = '';
  $('msaPageInfo').textContent = out.info;
  $('msaMeta').textContent = out.meta;
}
msaLoadSamples();

/* ---------------- SDT identity 矩阵在线热图 ---------------- */
async function sdtLoadGroups() {
  const s = $('sdtSample').value, sel = $('sdtGroup');
  if (!s) { sel.innerHTML = '<option value="">（先选样品）</option>'; return; }
  try {
    const list = await fetchSampleList();
    const item = list.find(x => x.sample === s);
    sel.innerHTML = (item?.groups || []).map(g =>
      `<option value="${esc(g.group)}">${esc(g.group)}</option>`).join('')
      || '<option value="">（该样品没有比对/矩阵）</option>';
    if (sel.value) sdtDraw();
  } catch (e) { sel.innerHTML = '<option value="">加载失败</option>'; }
}

async function sdtDraw() {
  const s = $('sdtSample').value, g = $('sdtGroup').value;
  const box = $('sdtHeat'), meta = $('sdtMeta');
  if (!s || !g) { box.style.display = 'none'; meta.textContent = ''; return; }
  meta.textContent = '计算/加载矩阵中…';
  try {
    const r = await fetch(`/api/sdt/data?sample=${encodeURIComponent(s)}&group=${encodeURIComponent(g)}`);
    if (!r.ok) { box.style.display = 'none'; meta.textContent = esc((await r.json()).error || '加载失败'); return; }
    const d = await r.json();
    const zmin = identityHeatmap('sdtHeat', d.names, d.matrix,
      `SDT 全长成对 identity 矩阵（${esc(s)} · ${esc(g)}）`);
    box.style.display = '';
    meta.textContent =
      `${d.names.length} 条序列 · 色标 ${zmin.toFixed(0)}–100% · 数据来源 ${d.source}` +
      (d.names.length >= 60 ? '（超出 60 条已截断显示）' : '');
  } catch (e) { box.style.display = 'none'; meta.textContent = '无法连接: ' + esc(e); }
}

async function sdtLoadSamples() {
  const sel = $('sdtSample');
  try {
    const list = await fetchSampleList();
    sel.innerHTML = list.length
      ? list.map(x => `<option value="${esc(x.sample)}">${esc(sampleLabel(x))}</option>`).join('')
      : '<option value="">暂无比对结果（先跑样品流程或集合建树）</option>';
    if (sel.value) sdtLoadGroups();
  } catch (e) { sel.innerHTML = '<option value="">加载失败</option>'; }
}

/* ---------------- 进化树查看（Archaeopteryx.js） ---------------- */
let treeSamples = [], treeNwk = null, treeMeta = {};

async function treeLoadSamples() {
  const sel = $('treeSample');
  try {
    const list = await fetchSampleList();
    // 仅列出含树文件的样品/分组
    treeSamples = list.map(x => ({
      sample: x.sample,
      label: sampleLabel(x),
      groups: (x.groups || []).filter(g => g.trees && g.trees.length)
    })).filter(x => x.groups.length);
    sel.innerHTML = treeSamples.length
      ? treeSamples.map(x => `<option value="${esc(x.sample)}">${esc(x.label || x.sample)}</option>`).join('')
      : `<option value="">${t('rs.noTree')}</option>`;
    if (sel.value) treeLoadGroups();
  } catch (e) { sel.innerHTML = '<option value="">加载失败</option>'; }
}

function treeGroups() {
  const s = $('treeSample').value;
  return (treeSamples.find(x => x.sample === s) || {}).groups || [];
}

function treeLoadGroups() {
  const sel = $('treeGroup'), groups = treeGroups();
  sel.innerHTML = groups.length
    ? groups.map(g => `<option value="${esc(g.group)}">${esc(g.group)}</option>`).join('')
    : `<option value="">${t('rs.noTree')}</option>`;
  if (sel.value) treeLoadFiles();
}

function treeLoadFiles() {
  const g = treeGroups().find(x => x.group === $('treeGroup').value);
  const sel = $('treeFile'), trees = (g && g.trees) || [];
  sel.innerHTML = trees.map(tr =>
    `<option value="${esc(tr.file)}">${esc(tr.label)}（${esc(tr.file)}）</option>`).join('')
    || `<option value="">${t('rs.noTreeFile')}</option>`;
  if (sel.value) treeLoad();
}

async function treeLoad() {
  const s = $('treeSample').value, g = $('treeGroup').value, f = $('treeFile').value;
  const box = $('treeBox');
  if (!s || !g || !f) { box.innerHTML = `<p class="hint">${t('c.noData')}</p>`; treeNwk = null; return; }
  box.innerHTML = `<p class="hint">${t('c.loading')}</p>`;
  try {
    const r = await fetch(`/api/tree/data?sample=${encodeURIComponent(s)}&group=${encodeURIComponent(g)}&file=${encodeURIComponent(f)}`);
    if (!r.ok) {
      treeNwk = null;
      box.innerHTML = '<p class="hint" style="color:#b91c1c">' + esc((await r.json()).error || '加载失败') + '</p>';
      return;
    }
    const d = await r.json();
    treeNwk = d.newick;
    treeMeta = d;
    treeRender();
  } catch (e) { box.innerHTML = '<p class="hint" style="color:#b91c1c">无法连接: ' + esc(e) + '</p>'; }
}

function treeRender() {
  const box = $('treeBox');
  if (!treeNwk) { box.innerHTML = `<p class="hint">${t('c.noData')}</p>`; $('treeMeta').textContent = ''; return; }
  let tips = 0;
  try {
    tips = renderTreeTo(box, treeNwk, { layout: 'rectangular' });
  } catch (e) {
    box.innerHTML = '<p class="hint" style="color:#b91c1c">树解析失败: ' + esc(e) + '</p>';
    return;
  }
  const m = treeMeta;
  $('treeMeta').textContent = [
    `${tips} 个序列`, m.tool, m.model ? '模型 ' + m.model : '',
    m.logl ? 'logL ' + m.logl : '', m.file,
    '查看器面板：布局切换 / 显示与支持值 / 缩放 / 搜索 / Download 导出',
  ].filter(Boolean).join(' · ');
}
async function loadHub() {
  const box = $('hubBox');
  if (!box) return;
  try {
    const [cols, jobs] = await Promise.all([
      fetch('/api/gb/collections').then(r => r.json()),
      fetch('/api/logan/jobs').then(r => r.json())]);
    const syn = cols.filter(c => c.has_compare);
    const log = jobs.filter(j => j.has_report);
    if (!syn.length && !log.length) {
      box.innerHTML = `<p class="hint">${t('hub.none')}</p>`;
      return;
    }
    let html = '';
    if (syn.length) {
      html += `<div class="subh">${t('hub.synteny')}</div>` + syn.map(c =>
        `<a class="btn small" style="margin:3px 8px 3px 0" href="/compare/${encodeURIComponent(c.name)}/" target="_blank">🧬 ${esc(c.name)}（${c.n_records} 基因组）</a>`).join('');
    }
    if (log.length) {
      html += `<div class="subh" style="margin-top:10px">${t('hub.logan')}</div>` + log.map(j =>
        `<a class="btn small" style="margin:3px 8px 3px 0" href="/logan/report/${encodeURIComponent(j.name)}/" target="_blank">🧭 ${esc(j.name)}</a>`).join('');
    }
    box.innerHTML = html;
  } catch (e) { box.innerHTML = '<p class="hint">加载失败</p>'; }
}
loadHub();

// ---------------- 专项分析运行（工具运行记录） ----------------
const openRuns = new Set();
async function loadSpecialRuns() {
  const box = $('runsBox');
  if (!box) return;
  try {
    const runs = await (await fetch('/api/tool/runs')).json();
    if (!runs.length) {
      box.innerHTML = '<p class="hint">' + t('c.noRunHistory','暂无运行记录（到各功能模块运行一次工具后，记录会出现在这里）') + '</p>';
      return;
    }
    box.innerHTML = runs.map(run => {
      const open = openRuns.has(run.name);
      const files = run.files || [];
      const fileHtml = open ? (files.length
        ? files.map(f =>
            `<div class="fitem"><a href="/tool_runs/${esc(run.name)}/${esc(f.path)}" download>📄 ${esc(f.path)}</a> <span class="hint">${esc(f.size)}</span></div>`).join('')
        : '<p class="hint">（无文件）</p>') : '';
      const isContig = run.name.startsWith('contigs_');
      return `<div style="border-bottom:1px dashed var(--line-100);padding:6px 0">
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <b class="mono">${esc(run.name)}</b>
          <span class="hint">${files.length} 文件</span>
          <button class="btn small" onclick="toggleRunFiles('${esc(run.name)}')">${open ? '收起' : '📁 文件'}</button>
          ${isContig ? `<a class="btn small primary" target="_blank" href="/api/tool/report?run=${esc(run.name)}">📊 分类报告</a>` : ''}
          <button class="btn small" onclick="openRunDir('${esc(run.name)}')" data-i18n="rs.openDirRun">📂 打开目录</button>
        </div>
        ${open ? `<div class="scroll-sm" style="margin-top:6px">${fileHtml}</div>` : ''}
      </div>`;
    }).join('');
  } catch (e) { box.innerHTML = '<p class="hint">加载失败</p>'; }
}
function toggleRunFiles(name) {
  if (openRuns.has(name)) openRuns.delete(name);
  else openRuns.add(name);
  loadSpecialRuns();
}
async function openRunDir(name) {
  try {
    await fetch('/api/tool/open', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name })});
  } catch (e) { alert('打开失败: ' + e); }
}
loadSpecialRuns();

sdtLoadSamples();
treeLoadSamples();

/* ---------------- 公共检索项目（meta_search 归档） ---------------- */
const MM = { colls: [], sort: {}, page: {}, tblState: {} };

async function mmLoad() {
  const box = $('mmBox');
  try {
    MM.colls = await (await fetch('/api/meta/collections')).json();
    if (!MM.colls.length) {
      box.innerHTML = '<p class="hint">' + t('c.noProject','暂无检索项目——到「公共数据检索」页检索一次，项目会自动归档到这里。') + '</p>';
      return;
    }
    box.innerHTML = MM.colls.map(c => {
      const slug = esc(c.name);
      const n = v => (v == null ? '—' : Number(v).toLocaleString());
      const badges = [];
      if (c.search) badges.push(`<span class="badge2 ok">检索 ${n(c.n_runs)}</span>`);
      if (c.core14) badges.push(`<span class="badge2 ${c.stale ? 'warn' : ''}">Core14 ${n(c.n_core14)}</span>`);
      if (c.full) badges.push(`<span class="badge2 ${c.stale ? 'warn' : ''}">Full ${n(c.n_full)}</span>`);
      if (c.n_plots) badges.push(`<span class="badge2">图表 ${n(c.n_plots)}</span>`);
      if (c.stale) badges.push(`<span class="badge2 warn" title="元数据条数与检索不一致——重新提取元数据">⚠ 过期</span>`);
      let acts = '';
      if (c.search) acts += `<button class="btn small" onclick="mmTable('${slug}','search')">📄 检索结果</button>`;
      if (c.core14) acts += `<button class="btn small" onclick="mmTable('${slug}','core14')">🧾 Core14</button>`;
      acts += `<a class="btn small primary" href="/meta?p=${slug}">✏️ 打开检索页</a>`;
      if (c.search) acts += `<a class="btn small" href="/meta_files/${slug}/search/SRA_GSA_Merged_Final.csv" download>⬇ CSV</a>`;
      if (c.full) acts += `<a class="btn small" href="/meta_files/${slug}/info/Global_Unified_Metadata_Full.csv" download>⬇ Full</a>`;
      acts += `<span style="flex:1"></span>
        <span class="hint">${esc(timeAgo(c.mtime))}</span>
        <button class="btn small danger" onclick="mmDel('${slug}')">🗑</button>`;
      return `<div style="border-bottom:1px dashed var(--line-100);padding:8px 0">
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <b class="mono" style="font-size:13px">${slug}</b>${badges.join(' ')}
        </div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px">${acts}</div>
        <div id="mmTbl_${slug}"></div>
      </div>`;
    }).join('');
  } catch (e) { box.innerHTML = '<p class="hint">加载失败</p>'; }
}

async function mmTable(name, which, page = 1) {
  const box = $(`mmTbl_${name}`);
  if (!box) return;
  if (MM.tblState[name] === which && box.dataset.on === '1' && !page) {
    box.innerHTML = ''; box.dataset.on = '0'; return;   // 再点一次收起
  }
  MM.tblState[name] = which; box.dataset.on = '1';
  const so = MM.sort[name + which] || {};
  const qs = new URLSearchParams({which, page, per_page: 20});
  if (so.col != null) { qs.set('sort', so.col); qs.set('dir', so.dir); }
  box.innerHTML = '<p class="hint">加载中…</p>';
  try {
    const d = await (await fetch(`/api/meta/table/${encodeURIComponent(name)}?${qs}`)).json();
    const rows = d.rows.map(r =>
      `<tr>${r.map(v => `<td title="${esc(v)}">${esc(v)}</td>`).join('')}</tr>`).join('');
    box.innerHTML = `
      <div class="tbl-scroll" style="max-height:320px;margin-top:8px"><table class="meta-tbl"><thead><tr>` +
      d.columns.map((c, i) => {
        const arrow = so.col === c ? (so.dir === 'asc' ? ' ▲' : ' ▼') : '';
        return `<th class="sortable" onclick="mmSort('${esc(name)}','${which}','${esc(c)}')">${esc(c)}${arrow}</th>`;
      }).join('') + `</tr></thead><tbody>${rows}</tbody></table></div>
      <div>${pagerHtml(d.page, d.pages, `mmPage('${esc(name)}','${which}','{p}')`)}</div>`;
  } catch (e) {
    box.innerHTML = `<p class="hint">✘ ${esc(e.message || '加载失败')}</p>`;
  }
}
function mmPage(name, which, p) { mmTable(name, which, p); }
function mmSort(name, which, col) {
  const key = name + which;
  const so = MM.sort[key] || (MM.sort[key] = {});
  if (so.col === col) so.dir = so.dir === 'asc' ? 'desc' : 'asc';
  else { so.col = col; so.dir = 'asc'; }
  mmTable(name, which, 1);
}
async function mmDel(name) {
  if (!confirm(`删除检索项目 "${name}" ？该项目的检索结果 / 元数据 / 图表将一并删除。`)) return;
  try {
    await fetch(`/api/meta/collection/${encodeURIComponent(name)}/delete`, {method: 'POST'});
    mmLoad();
  } catch (e) { alert('删除失败: ' + e); }
}
function timeAgo(ts) {
  if (!ts) return '';
  const s = Date.now() / 1000 - ts;
  if (s < 3600) return Math.max(1, Math.floor(s / 60)) + ' 分钟前';
  if (s < 86400) return Math.floor(s / 3600) + ' 小时前';
  return new Date(ts * 1000).toLocaleDateString();
}
mmLoad();

/* ---------------- 分区导航：与其他二级页一致（一次一个区，hash 深链兼容） ----------------
   #samples / #meta / #runs / #sdt / #msa / #tree / #seqview（比较基因组组的 /results#msa 等旧链接直接可用） */
const RS_SECS = ['samples', 'meta', 'runs', 'sdt', 'msa', 'tree', 'seqview'];
function rsShow(id) {
  if (!RS_SECS.includes(id)) id = 'samples';
  document.querySelectorAll('.rs-sec').forEach(el => {
    el.style.display = el.id === 'sec-' + id ? '' : 'none';
  });
  document.querySelectorAll('#rsPills .gt-item').forEach(a => {
    a.classList.toggle('on', a.dataset.sec === id);
  });
}
(function rsInit() {
  document.querySelectorAll('#rsPills .gt-item').forEach(a => {
    a.addEventListener('click', ev => {
      ev.preventDefault();
      history.replaceState(null, '', '#' + a.dataset.sec);
      rsShow(a.dataset.sec);
    });
  });
  rsShow((location.hash || '').replace('#', ''));
})();
window.addEventListener('hashchange', () => rsShow((location.hash || '').replace('#', '')));
</script>
