let VP_LANG = 'zh';
try {
  // 服务端语言（platform.json）优先；localStorage 仅作 meta 缺失时的兜底
  const m = document.querySelector('meta[name="vp-lang"]');
  const saved = localStorage.getItem('vp_lang');
  VP_LANG = (m && m.content) || saved || 'zh';
} catch (e) { /* localStorage 不可用时保持服务端语言 */ }
if (!I18N_DICT[VP_LANG]) VP_LANG = 'zh';

function t(key, fallback) {
  const d = I18N_DICT[VP_LANG] || {};
  if (d[key] != null) return d[key];
  const z = I18N_DICT.zh[key];
  if (z != null) return z;
  return fallback != null ? fallback : key;
}

function applyI18n(root) {
  root = root || document;
  root.querySelectorAll('[data-i18n]').forEach(el => {
    const v = t(el.dataset.i18n, null);
    if (v != null) el.innerHTML = v;
  });
  root.querySelectorAll('[data-i18n-ph]').forEach(el => {
    const v = t(el.dataset.i18nPh, null);
    if (v != null) el.placeholder = v;
  });
  root.querySelectorAll('[data-i18n-title]').forEach(el => {
    const v = t(el.dataset.i18nTitle, null);
    if (v != null) el.title = v;
  });
}

async function setLang(lang) {
  if (!I18N_DICT[lang] || lang === VP_LANG) return;
  try { localStorage.setItem('vp_lang', lang); } catch (e) {}
  try {
    await fetch('/api/settings', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({language: lang})});
  } catch (e) { /* 服务端持久化失败也继续切前端 */ }
  location.reload();
}

/* 在导航栏注入语言切换按钮（所有页面统一） */
function injectLangSwitch() {
  const nav = document.querySelector('.navlinks');
  if (!nav || document.getElementById('langBtn')) return;
  const btn = document.createElement('button');
  btn.id = 'langBtn';
  btn.className = 'langbtn';
  btn.type = 'button';
  const show = () => { btn.textContent = VP_LANG === 'zh' ? 'EN' : '中文'; };
  show();
  btn.title = VP_LANG === 'zh' ? 'Switch to English' : '切换到中文';
  btn.onclick = () => setLang(VP_LANG === 'zh' ? 'en' : 'zh');
  // 插到 📂 图标前
  const anchor = nav.querySelector('.iconbtn');
  nav.insertBefore(btn, anchor || null);
}

document.addEventListener('DOMContentLoaded', () => {
  injectLangSwitch();
  applyI18n();
});
